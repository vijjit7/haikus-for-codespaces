                            // Use last 4 digits ONLY for grouping key (not bank name)
                            // This ensures same account gets grouped even if bank name differs
                            let last4 = details.last4Digits || 'XXXX';
                            if (last4 === 'N/A') {
                                // Fallback: extract last 4 digits from account number
                                const digitsOnly = acNo.replace(/[^0-9]/g, '');
                                last4 = digitsOnly.length >= 4 ? digitsOnly.slice(-4) : (digitsOnly || 'XXXX');
                            }
                            
                            // Key is just the last 4 digits (not including bank name)
                            const key = last4;

                            if (!accountGroups[key]) {
                                accountGroups[key] = {
                                    bankName: bankName,
                                    accountNumber: acNo,
                                    last4Digits: last4,
                                    holderName: holderName,
                                    periods: []
                                };
                            } else {
