        // Dismiss a pending document item (mark as not required)
        async function dismissPendingItem(category, index, button) {
            const listItem = button.closest('li');
            const pendingText = listItem.getAttribute('data-pending-text');

            if (!confirm('Are you sure you want to dismiss this pending item?\n\n"' + pendingText + '"\n\nThis will mark it as not required.')) {
                return;
            }

            try {
                const response = await fetch(`/stage2/${proposalId}/dismiss-pending`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ category, pendingText })
                });

                const result = await response.json();

                if (result.success) {
                    // Find and remove matching items from ALL tabs (both ALL tab and category-specific tab)
                    const allMatchingItems = document.querySelectorAll(`li.pending-item[data-pending-text="${CSS.escape(pendingText)}"]`);
                    allMatchingItems.forEach(item => {
                        item.style.transition = 'all 0.3s ease';
                        item.style.opacity = '0';
                        item.style.transform = 'translateX(20px)';
                        setTimeout(() => {
                            item.remove();
                        }, 300);
                    });
                    
                    // Update the counts after a short delay
                    setTimeout(() => {
                        updatePendingTabCount(category);
                    }, 350);
                } else {
                    alert('Failed to dismiss: ' + result.error);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        // Update the pending tab count after dismissing an item
        function updatePendingTabCount(category) {
            const tabBtn = document.querySelector(`.tab-btn-pending[onclick*="'${category}'"]`);
            if (tabBtn) {
                const match = tabBtn.textContent.match(/\((\d+)\)/);
                if (match) {
                    const newCount = parseInt(match[1]) - 1;
                    tabBtn.textContent = tabBtn.textContent.replace(/\(\d+\)/, `(${newCount})`);
                }
            }
            // Also update ALL tab count
            const allTabBtn = document.querySelector('.tab-btn-pending[onclick*="\'all\'"]');
            if (allTabBtn) {
                const match = allTabBtn.textContent.match(/\((\d+)\)/);
                if (match) {
                    const newCount = parseInt(match[1]) - 1;
                    allTabBtn.textContent = allTabBtn.textContent.replace(/\(\d+\)/, `(${newCount})`);
                }
            }
        }

