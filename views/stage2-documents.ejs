                                        if (doc.extractedDetails) {
                                            if (doc.extractedDetails.deedDate) hasExtractedDate = true;
                                            if (doc.extractedDetails.partners && doc.extractedDetails.partners.length > 0) hasExtractedPartners = true;
                                        }
