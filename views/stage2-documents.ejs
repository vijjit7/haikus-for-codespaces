        // Check if PDF is password protected
        async function checkPdfPasswordProtection(url) {
            try {
                const response = await fetch(url);
                const arrayBuffer = await response.arrayBuffer();
                const uint8Array = new Uint8Array(arrayBuffer);

                // Check for encryption dictionary in PDF header/trailer
                // Look for /Encrypt in the PDF content (first 10KB should be enough)
                const textDecoder = new TextDecoder('latin1');
                const pdfText = textDecoder.decode(uint8Array.slice(0, Math.min(10000, uint8Array.length)));

                // Check for encryption markers in PDF structure
                if (pdfText.includes('/Encrypt')) {
                    return true;
                }

                // Also check near the end of PDF for xref/trailer with Encrypt
                if (uint8Array.length > 10000) {
                    const tailText = textDecoder.decode(uint8Array.slice(-5000));
                    if (tailText.includes('/Encrypt')) {
                        return true;
                    }
                }

                return false;
            } catch (error) {
                console.error('Error checking PDF protection:', error);
                return false;
            }
        }

