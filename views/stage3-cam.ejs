                <div id="debtProfilePanel" class="analysis-panel">
                    <h3>Debt Profile Analysis</h3>
                    
                    <%
                    // Initialize debtProfiles if not defined
                    const debtProfilesList = typeof debtProfiles !== 'undefined' ? debtProfiles : [];
                    
                    // EMI Calculation function: EMI = P × r × (1+r)^n / ((1+r)^n - 1)
                    function calculateEMI(principal, annualRate, tenureMonths) {
                        if (!principal || !annualRate || !tenureMonths || principal <= 0 || tenureMonths <= 0) {
                            return null;
                        }
                        const monthlyRate = annualRate / 12 / 100;
                        if (monthlyRate === 0) {
                            return Math.round(principal / tenureMonths);
                        }
                        const emi = principal * monthlyRate * Math.pow(1 + monthlyRate, tenureMonths) / (Math.pow(1 + monthlyRate, tenureMonths) - 1);
                        return Math.round(emi);
                    }

                    // POS (Principal Outstanding) Calculation
                    function calculatePOS(principal, annualRate, tenureMonths, monthsCompleted) {
                        if (!principal || !tenureMonths || principal <= 0 || tenureMonths <= 0) {
                            return null;
                        }
                        if (!monthsCompleted || monthsCompleted <= 0) {
                            return principal;
                        }
                        if (monthsCompleted >= tenureMonths) {
                            return 0;
                        }
                        const monthlyRate = annualRate / 12 / 100;
                        if (monthlyRate === 0) {
                            return Math.round(principal - (principal / tenureMonths) * monthsCompleted);
                        }
                        const n = tenureMonths;
                        const k = monthsCompleted;
                        const pos = principal * (Math.pow(1 + monthlyRate, n) - Math.pow(1 + monthlyRate, k)) / (Math.pow(1 + monthlyRate, n) - 1);
                        return Math.round(pos);
                    }

                    // Check EMI tolerance (allow 2% variance)
                    function isEMIMatching(enteredEMI, calculatedEMI) {
                        if (!enteredEMI || !calculatedEMI) return true;
                        const tolerance = calculatedEMI * 0.02;
                        return Math.abs(enteredEMI - calculatedEMI) <= tolerance;
                    }
                    %>
                    
                    <!-- Debt Profile Summary Table -->
                    <% if (debtProfilesList.length > 0) { %>
                    <div style="margin-bottom: 30px;">
                        <h4 style="margin-bottom: 15px; color: #1976d2;">📋 Debt Profile Summary</h4>
                        <div style="overflow-x:auto;">
                        <table border="1" style="width:100%;border-collapse:collapse;background:#fff;font-size:0.9em;">
                            <thead>
                                <tr style="background:#e3f2fd;">
                                    <th style="padding:8px;">S.No</th>
                                    <th style="padding:8px;">Applicant</th>
                                    <th style="padding:8px;">Bank Name</th>
                                    <th style="padding:8px;">Loan Type</th>
                                    <th style="padding:8px;">Loan Amount</th>
                                    <th style="padding:8px;">POS</th>
                                    <th style="padding:8px;">EMI (Entered)</th>
                                    <th style="padding:8px;">EMI (Calculated)</th>
                                    <th style="padding:8px;">ROI %</th>
                                    <th style="padding:8px;">Sanction Date</th>
                                    <th style="padding:8px;">Tenure (Months)</th>
                                    <th style="padding:8px;">EMI Start Date</th>
                                    <th style="padding:8px;">EMI End Date</th>
                                    <th style="padding:8px;">Months Completed</th>
                                    <th style="padding:8px;">% Tenure Completed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <%
                                let totalLoanAmount = 0;
                                let totalEmi = 0;
                                let totalCalculatedEmi = 0;
                                let totalPOS = 0;
                                debtProfilesList.forEach(function(profile) {
                                    totalLoanAmount += profile.loanAmount || 0;
                                    totalEmi += profile.emi || 0;

                                    const calculatedEMI = calculateEMI(profile.loanAmount, profile.roi, profile.tenure);
                                    if (calculatedEMI) totalCalculatedEmi += calculatedEMI;
                                    const emiMatches = isEMIMatching(profile.emi, calculatedEMI);

                                    const pos = calculatePOS(profile.loanAmount, profile.roi, profile.tenure, profile.monthsCompleted);
                                    if (pos !== null) totalPOS += pos;
                                %>
                                    <tr>
                                        <td style="padding:8px;text-align:center;"><%= profile.sNo %></td>
                                        <td style="padding:8px;"><%= profile.loanApplicant %></td>
                                        <td style="padding:8px;"><%= profile.bank %></td>
                                        <td style="padding:8px;"><%= profile.loanType %></td>
                                        <td style="padding:8px;text-align:right;"><%= profile.loanAmount ? profile.loanAmount.toLocaleString('en-IN') : '' %></td>
                                        <td style="padding:8px;text-align:right;background:#fff8e1;">
                                            <% if (pos !== null) { %>
                                                <strong>₹<%= pos.toLocaleString('en-IN') %></strong>
                                                <% if (profile.loanAmount && pos > 0) { %>
                                                    <div style="font-size:0.7em;color:#666;">
                                                        (<%= Math.round((pos / profile.loanAmount) * 100) %>% remaining)
                                                    </div>
                                                <% } %>
                                            <% } else { %>
                                                <span style="color:#999;font-size:0.8em;">N/A</span>
                                            <% } %>
                                        </td>
                                        <td style="padding:8px;text-align:right;<%= !emiMatches ? 'background:#ffebee;' : '' %>">
                                            <div style="display:flex;align-items:center;justify-content:flex-end;gap:5px;">
                                                <span><%= profile.emi ? profile.emi.toLocaleString('en-IN') : '' %></span>
                                                <% if (!emiMatches && calculatedEMI) { %>
                                                    <span style="color:#d32f2f;font-weight:bold;" title="EMI mismatch! Expected: ₹<%= calculatedEMI.toLocaleString('en-IN') %>">❌</span>
                                                <% } else if (emiMatches && calculatedEMI && profile.emi) { %>
                                                    <span style="color:#4caf50;" title="EMI verified">✓</span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td style="padding:8px;text-align:right;<%= !emiMatches ? 'background:#e8f5e9;font-weight:bold;' : '' %>">
                                            <% if (calculatedEMI) { %>
                                                <%= calculatedEMI.toLocaleString('en-IN') %>
                                                <% if (!emiMatches && profile.emi) { %>
                                                    <div style="font-size:0.75em;color:#d32f2f;">
                                                        (Diff: ₹<%= Math.abs(profile.emi - calculatedEMI).toLocaleString('en-IN') %>)
                                                    </div>
                                                <% } %>
                                            <% } else { %>
                                                <span style="color:#999;font-size:0.8em;">N/A</span>
                                            <% } %>
                                        </td>
                                        <td style="padding:8px;text-align:center;"><%= profile.roi %><%= profile.roi ? '%' : '' %></td>
                                        <td style="padding:8px;text-align:center;"><%= profile.sanctionDate %></td>
                                        <td style="padding:8px;text-align:center;"><%= profile.tenure %></td>
                                        <td style="padding:8px;text-align:center;"><%= profile.emiStartDate %></td>
                                        <td style="padding:8px;text-align:center;"><%= profile.emiEndDate %></td>
                                        <td style="padding:8px;text-align:center;"><%= profile.monthsCompleted %></td>
                                        <td style="padding:8px;text-align:center;">
                                            <div style="display:flex;align-items:center;gap:5px;">
                                                <div style="flex:1;background:#e0e0e0;border-radius:4px;height:8px;">
                                                    <div style="width:<%= profile.percentTenureCompleted %>%;background:<%= profile.percentTenureCompleted >= 80 ? '#4caf50' : profile.percentTenureCompleted >= 50 ? '#ff9800' : '#2196f3' %>;height:100%;border-radius:4px;"></div>
                                                </div>
                                                <span><%= profile.percentTenureCompleted %>%</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                            <tfoot>
                                <tr style="background:#e8f5e9; font-weight:bold;">
                                    <td style="padding:10px;text-align:center;" colspan="4"><strong>TOTAL</strong></td>
                                    <td style="padding:10px;text-align:right;"><strong>₹<%= totalLoanAmount.toLocaleString('en-IN') %></strong></td>
                                    <td style="padding:10px;text-align:right;background:#fff8e1;"><strong>₹<%= totalPOS.toLocaleString('en-IN') %></strong></td>
                                    <td style="padding:10px;text-align:right;"><strong>₹<%= totalEmi.toLocaleString('en-IN') %></strong></td>
                                    <td style="padding:10px;text-align:right;"><strong>₹<%= totalCalculatedEmi.toLocaleString('en-IN') %></strong></td>
                                    <td style="padding:10px;" colspan="7"></td>
                                </tr>
                            </tfoot>
                        </table>
                        </div>
                    </div>
                    <% } else { %>
                        <p style="color: #666; font-style: italic; margin-bottom: 20px;">
                            No debt profile data available. Please upload debt profile documents in Stage 2.
                        </p>
                    <% } %>
                    
                    <!-- EMI Tracking Section -->
                    <h4 style="margin-bottom: 15px; color: #1976d2;">📅 EMI Tracking (Jan'26 to Feb'25)</h4>
                    
                    <%
                    // Get banking documents from proposal
                    const bankingDocs = (proposal.documents || []).filter(d => d.category === 'banking');
                    
                    // EMI Verification logic (same as Stage 2)
                    const emiFoundInAccountsStage3 = {};
                    
                    // Helper function to check if EMI exists in context
                    const checkEmiInContextStage3 = (text, emiAmount, loanBankName) => {
                        const emiStr = String(emiAmount);
                        const emiFormatted = emiAmount.toLocaleString('en-IN');
                        const emiWithDecimals = emiFormatted + '.00';
                        
                        const emiKeywords = ['emi', 'loan', 'equated monthly', 'instalment', 'installment', 'nach', 'ecs', 'auto debit', 'si:', 'standing instruction', 'ach d-', 'ach-d'];
                        
                        const bankNameLower = (loanBankName || '').toLowerCase().trim();
                        const bankNameParts = bankNameLower.split(/[\s\-]+/).filter(p => p.length > 2);
                        
                        const lines = text.split(/[\n\r]+/);
                        
                        for (let i = 0; i < lines.length; i++) {
                            const lineLower = lines[i].toLowerCase();
                            const hasEmiKeyword = emiKeywords.some(kw => lineLower.includes(kw));
                            const hasBankName = bankNameParts.length > 0 && bankNameParts.some(part => lineLower.includes(part));
                            
                            if (hasEmiKeyword || hasBankName) {
                                for (let j = i; j < Math.min(i + 6, lines.length); j++) {
                                    const checkLine = lines[j].toLowerCase();
                                    const hasEmiAmount = checkLine.includes(emiStr) || 
                                                         checkLine.includes(emiFormatted.toLowerCase()) ||
                                                         checkLine.includes(emiWithDecimals.toLowerCase()) ||
                                                         checkLine.includes((emiAmount - 1).toString()) ||
                                                         checkLine.includes((emiAmount + 1).toString());
                                    
                                    if (hasEmiAmount) {
                                        return true;
                                    }
                                }
                            }
                        }
                        
                        // Fallback check
                        const textLower = text.toLowerCase();
                        if (textLower.includes(emiWithDecimals.toLowerCase()) || textLower.includes(emiFormatted.toLowerCase())) {
                            const hasAnyEmiKeyword = emiKeywords.some(kw => textLower.includes(kw));
                            const hasAnyBankName = bankNameParts.some(part => textLower.includes(part));
                            if (hasAnyEmiKeyword || hasAnyBankName) {
                                return true;
                            }
                        }
                        return false;
                    };
                    
                    // Perform EMI verification for each debt profile
                    if (debtProfilesList.length > 0 && bankingDocs.length > 0) {
                        debtProfilesList.forEach(profile => {
                            if (profile.emi && profile.emi > 0) {
                                const emiAmount = Math.round(profile.emi);
                                const loanBankName = profile.bank || '';
                                
                                let foundInAccount = null;
                                let foundInAnyDoc = false;
                                
                                for (const doc of bankingDocs) {
                                    if (doc.extractedText) {
                                        const docText = doc.extractedText.toLowerCase();
                                        const emiFound = checkEmiInContextStage3(docText, emiAmount, loanBankName);
                                        
                                        if (emiFound) {
                                            foundInAnyDoc = true;
                                            if (doc.extractedDetails && doc.extractedDetails.accountNumber && doc.extractedDetails.accountNumber !== 'N/A') {
                                                foundInAccount = doc.extractedDetails.accountNumber;
                                                break;
                                            }
                                        }
                                    }
                                }
                                
                                if (foundInAnyDoc) {
                                    emiFoundInAccountsStage3[profile._id] = {
                                        found: true,
                                        accountNumber: foundInAccount || ''
                                    };
                                } else {
                                    emiFoundInAccountsStage3[profile._id] = { found: false, accountNumber: '' };
                                }
                            }
                        });
                    }
                    
                    // Fixed 12 months: Jan 2026 to Feb 2025 (reverse chronological)
                    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                    const months = [
                        { month: 0, year: 2026, label: 'Jan', fullLabel: 'Jan 2026' },
                        { month: 11, year: 2025, label: 'Dec', fullLabel: 'Dec 2025' },
                        { month: 10, year: 2025, label: 'Nov', fullLabel: 'Nov 2025' },
                        { month: 9, year: 2025, label: 'Oct', fullLabel: 'Oct 2025' },
                        { month: 8, year: 2025, label: 'Sep', fullLabel: 'Sep 2025' },
                        { month: 7, year: 2025, label: 'Aug', fullLabel: 'Aug 2025' },
                        { month: 6, year: 2025, label: 'Jul', fullLabel: 'Jul 2025' },
                        { month: 5, year: 2025, label: 'Jun', fullLabel: 'Jun 2025' },
                        { month: 4, year: 2025, label: 'May', fullLabel: 'May 2025' },
                        { month: 3, year: 2025, label: 'Apr', fullLabel: 'Apr 2025' },
                        { month: 2, year: 2025, label: 'Mar', fullLabel: 'Mar 2025' },
                        { month: 1, year: 2025, label: 'Feb', fullLabel: 'Feb 2025' }
                    ];
                    
                    // Helper to format number in Indian numbering system (e.g., 175759 -> 1,75,759)
                    const formatIndian = (num) => {
                        const s = String(Math.abs(Math.round(num)));
                        if (s.length <= 3) return s;
                        let result = s.slice(-3);
                        let remaining = s.slice(0, -3);
                        while (remaining.length > 0) {
                            result = remaining.slice(-2) + ',' + result;
                            remaining = remaining.slice(0, -2);
                        }
                        return num < 0 ? '-' + result : result;
                    };

                    // Generate all possible search variants for an amount
                    const getAmountVariants = (amount, tolerance = 2) => {
                        const variants = [];
                        const amountsToCheck = [amount];
                        
                        for (let t = 1; t <= tolerance; t++) {
                            amountsToCheck.push(amount + t);
                            amountsToCheck.push(amount - t);
                        }
                        
                        amountsToCheck.forEach(amt => {
                            const intVal = Math.round(amt);
                            variants.push(String(intVal));
                            variants.push(intVal + '.00');
                            const indianFmt = formatIndian(intVal);
                            variants.push(indianFmt);
                            variants.push(indianFmt + '.00');
                            const westernFmt = intVal.toLocaleString('en-US');
                            variants.push(westernFmt);
                            variants.push(westernFmt + '.00');
                        });
                        
                        // Remove duplicates
                        return [...new Set(variants)];
                    };

                    // Clean bank statement text for better matching
                    const cleanBankText = (text) => {
                        let cleaned = text.replace(/(\d)\s*[\n\r]\s*(\.\d)/g, '$1$2');
                        cleaned = cleaned.replace(/[ \t]+/g, ' ');
                        return cleaned;
                    };

                    // Function to find EMI dates in bank statements
                    function findEmiDatesInStatements(emiAmount, bankName, bankingDocs) {
                        const emiDates = [];
                        if (!emiAmount || !bankingDocs) return emiDates;
                        
                        const emiVariants = getAmountVariants(Math.round(emiAmount), 2);
                        
                        // Bank name parts for matching
                        const bankNameLower = (bankName || '').toLowerCase();
                        const bankNameParts = bankNameLower.split(/[\s\-]+/).filter(p => p.length > 2);
                        
                        // EMI keywords (expanded list)
                        const emiKeywords = ['ach d-', 'ach-d', 'nach', 'ecs', 'emi', 'loan', 'auto debit', 'instalment', 'installment', 'equated monthly', 'cms/', 'adibi', 'trf/', 'fin ltd', 'capital', 'finance', 'birla', 'clix', 'icici', 'unity'];
                        
                        // Date patterns: dd/mm/yyyy and dd-Mon-yyyy
                        const dateRegexNumeric = /(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/g;
                        const monthNamesMapEmi = {jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11};
                        const dateRegexNamed = /(\d{1,2})[\/\-](\w{3})[\/\-](\d{4})/gi;

                        bankingDocs.forEach(doc => {
                            if (!doc.extractedText) return;
                            const text = cleanBankText(doc.extractedText).toLowerCase();

                            // Find all positions where EMI amount appears
                            const emiPositions = [];
                            emiVariants.forEach(variant => {
                                const varLower = variant.toLowerCase();
                                let idx = text.indexOf(varLower);
                                while (idx !== -1) {
                                    emiPositions.push({pos: idx, variant: variant});
                                    idx = text.indexOf(varLower, idx + 1);
                                }
                            });

                            if (emiPositions.length === 0) return;

                            // For each EMI position, find the CLOSEST date before it (within 200 chars)
                            emiPositions.forEach(({pos: emiPos}) => {
                                // Look for context just before the amount (where transaction date usually is)
                                const contextStart = Math.max(0, emiPos - 200);
                                const contextBefore = text.substring(contextStart, emiPos);

                                // Check if context has EMI keyword or bank name
                                const hasEmiKeyword = emiKeywords.some(kw => contextBefore.includes(kw));
                                const hasBankName = bankNameParts.length > 0 && bankNameParts.some(part => contextBefore.includes(part));

                                if (hasEmiKeyword || hasBankName) {
                                    // Find ALL dates in this context (both numeric and named month formats)
                                    const allDates = [];
                                    let dateMatch;
                                    // Numeric: dd/mm/yyyy or dd-mm-yyyy
                                    const regexNum = new RegExp(dateRegexNumeric.source, 'g');
                                    while ((dateMatch = regexNum.exec(contextBefore)) !== null) {
                                        allDates.push({
                                            day: parseInt(dateMatch[1]),
                                            month: parseInt(dateMatch[2]) - 1,
                                            year: parseInt(dateMatch[3]),
                                            pos: dateMatch.index,
                                            dateStr: dateMatch[0]
                                        });
                                    }
                                    // Named month: dd-Mon-yyyy or dd/Mon/yyyy
                                    const regexNamed = new RegExp(dateRegexNamed.source, 'gi');
                                    while ((dateMatch = regexNamed.exec(contextBefore)) !== null) {
                                        const monthIdx = monthNamesMapEmi[dateMatch[2].toLowerCase()];
                                        if (monthIdx !== undefined) {
                                            // Avoid duplicates from numeric regex
                                            const alreadyFound = allDates.some(d => Math.abs(d.pos - dateMatch.index) < 5);
                                            if (!alreadyFound) {
                                                allDates.push({
                                                    day: parseInt(dateMatch[1]),
                                                    month: monthIdx,
                                                    year: parseInt(dateMatch[3]),
                                                    pos: dateMatch.index,
                                                    dateStr: dateMatch[0]
                                                });
                                            }
                                        }
                                    }
                                    allDates.sort((a, b) => a.pos - b.pos);

                                    // Take only the LAST date (closest to EMI amount)
                                    if (allDates.length > 0) {
                                        const closestDate = allDates[allDates.length - 1];
                                        let day = closestDate.day;
                                        let month = closestDate.month;
                                        let year = closestDate.year;

                                        // Validate date range (2024-2026)
                                        if (day >= 1 && day <= 31 && month >= 0 && month <= 11 && year >= 2024 && year <= 2026) {
                                            const exists = emiDates.some(ed => ed.day === day && ed.month === month && ed.year === year);
                                            if (!exists) {
                                                emiDates.push({
                                                    day: day,
                                                    month: month,
                                                    year: year,
                                                    dateStr: closestDate.dateStr
                                                });
                                            }
                                        }
                                    }
                                }
                            });
                        });
                        
                        return emiDates;
                    }
                    
                    // EMI verification data structure
                    const emiFoundInAccounts = {};
                    %>
                    
                    <% if (debtProfilesList.length > 0) { %>
                    <div style="margin-bottom: 20px;">
                        <button onclick="refreshEmiTracking()" style="padding: 8px 15px; background: #1976d2; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.9em;">
                            🔄 Refresh EMI Tracking
                        </button>
                    </div>
                    
                    <div style="overflow-x: auto;">
                        <table border="1" style="width:100%;border-collapse:collapse;background:#fff;font-size:0.85em;">
                            <thead>
                                <tr style="background:#e3f2fd;">
                                    <th style="padding:6px;min-width:30px;">S.No</th>
                                    <th style="padding:6px;min-width:120px;">Applicant</th>
                                    <th style="padding:6px;min-width:150px;">Bank Name</th>
                                    <th style="padding:6px;min-width:80px;">Loan Amount</th>
                                    <th style="padding:6px;min-width:60px;">EMI</th>
                                    <th style="padding:6px;min-width:80px;">EMI in Bank Stmt</th>
                                    <th style="padding:6px;min-width:70px;">EMI Start</th>
                                    <th style="padding:6px;min-width:50px;">Tenure</th>
                                    <th style="padding:6px;background:#fff3e0;min-width:60px;font-weight:bold;">Jan'26-Feb'25</th>
                                    <% months.forEach(function(m) { %>
                                        <th style="padding:4px;min-width:45px;font-size:0.85em;background:#f5f5f5;"><%= m.label %><br><span style="font-size:0.7em;color:#666;"><%= m.year %></span></th>
                                    <% }); %>
                                </tr>
                            </thead>
                            <tbody>
                                <%
                                debtProfilesList.forEach(function(profile, idx) {
                                    // Find EMI dates for this profile
                                    const emiDates = findEmiDatesInStatements(profile.emi, profile.bank, bankingDocs);
                                    
                                    // Count EMIs found per month
                                    const emiByMonth = {};
                                    months.forEach(m => {
                                        emiByMonth[m.month + '-' + m.year] = [];
                                    });
                                    
                                    emiDates.forEach(ed => {
                                        const key = ed.month + '-' + ed.year;
                                        if (emiByMonth[key]) {
                                            emiByMonth[key].push(ed.day);
                                        }
                                    });
                                    
                                    // Count total months with EMI found
                                    let monthsWithEmi = 0;
                                    months.forEach(m => {
                                        if (emiByMonth[m.month + '-' + m.year].length > 0) monthsWithEmi++;
                                    });
                                %>
                                    <tr>
                                        <td style="padding:6px;text-align:center;"><%= idx + 1 %></td>
                                        <td style="padding:6px;font-size:0.9em;"><%= profile.loanApplicant %></td>
                                        <td style="padding:6px;font-size:0.9em;"><%= profile.bank %></td>
                                        <td style="padding:6px;text-align:right;"><%= profile.loanAmount ? '₹' + profile.loanAmount.toLocaleString('en-IN') : '' %></td>
                                        <td style="padding:6px;text-align:right;font-weight:bold;"><%= profile.emi ? '₹' + Math.round(profile.emi).toLocaleString('en-IN') : '' %></td>
                                        <%
                                        // Get EMI bank statement status - combine auto-detection with database value (same as Stage 2)
                                        const autoDetectedStage3 = emiFoundInAccountsStage3[profile._id] || { found: false, accountNumber: '' };
                                        const isEmiFoundInStmt = autoDetectedStage3.found || profile.emiBankStatementProvided || false;
                                        const emiBankAccountNo = autoDetectedStage3.accountNumber || profile.emiBankAccountNumber || '';
                                        const emiBankLast4Display = emiBankAccountNo ? emiBankAccountNo.replace(/\D/g, '').slice(-4) : '';
                                        %>
                                        <td style="padding:6px;text-align:center;<%= isEmiFoundInStmt ? 'background:#e8f5e9;' : 'background:#ffebee;' %>">
                                            <div style="display:flex;flex-direction:column;align-items:center;gap:2px;">
                                                <span style="font-size:0.8em;font-weight:bold;color:<%= isEmiFoundInStmt ? '#4caf50' : '#d32f2f' %>;">
                                                    <%= isEmiFoundInStmt ? '✓ Found' : '✗ Not Found' %>
                                                </span>
                                                <% if (emiBankLast4Display) { %>
                                                    <span style="font-size:0.75em;color:#1976d2;">****<%= emiBankLast4Display %></span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td style="padding:6px;text-align:center;font-size:0.85em;"><%= profile.emiStartDate || '-' %></td>
                                        <td style="padding:6px;text-align:center;"><%= profile.tenure || '-' %></td>
                                        <td style="padding:6px;text-align:center;background:#fff3e0;font-weight:bold;">
                                            <span style="color:<%= monthsWithEmi >= 10 ? '#4caf50' : monthsWithEmi >= 6 ? '#ff9800' : '#d32f2f' %>;">
                                                Tracking
                                            </span>
                                        </td>
                                        <% months.forEach(function(m) { 
                                            const key = m.month + '-' + m.year;
                                            const daysFound = emiByMonth[key] || [];
                                            const hasEmi = daysFound.length > 0;
                                            const displayDay = hasEmi ? String(daysFound[0]).padStart(2, '0') : '';
                                            const displayMonth = String(m.month + 1).padStart(2, '0');
                                        %>
                                            <td style="padding:4px;text-align:center;background:<%= hasEmi ? '#e8f5e9' : '#ffebee' %>;font-size:0.85em;">
                                                <% if (hasEmi) { %>
                                                    <span style="color:#2e7d32;font-weight:bold;" title="EMI found on <%= displayDay %>/<%= displayMonth %>/<%= m.year %>">
                                                        <%= displayDay %>/<%= displayMonth %>
                                                    </span>
                                                <% } else { %>
                                                    <span style="color:#999;">-</span>
                                                <% } %>
                                            </td>
                                        <% }); %>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    
                    <div style="margin-top: 10px; padding: 10px; background: #f5f5f5; border-radius: 4px; font-size: 0.85em;">
                        <strong>Legend:</strong>
                        <span style="margin-left: 15px; padding: 2px 8px; background: #e8f5e9; border-radius: 3px;">DD/MM</span> = EMI found on that date
                        <span style="margin-left: 15px; padding: 2px 8px; background: #ffebee; border-radius: 3px; color: #999;">-</span> = EMI not found for that month
                    </div>
                    <% } else { %>
                    <div class="placeholder-content">
                        <div class="icon">💳</div>
                        <p>No debt profile data available. Please add debt profile information in Stage 2.</p>
                    </div>
                    <% } %>
                </div>

                <div id="collateralPanel" class="analysis-panel">
                    <h3>Collateral Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">🏠</div>
                        <p>Collateral documents - Technical & Legal analysis will be displayed here.</p>
                    </div>
                </div>

                <div id="networthPanel" class="analysis-panel">
                    <h3>Net Worth Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">📊</div>
                        <p>Asset base and net worth of customer will be displayed here.</p>
                    </div>
                </div>

                <div id="eligibilityPanel" class="analysis-panel">
                    <h3>Eligibility Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">✅</div>
                        <p>Eligibility basis and calculations will be displayed here.</p>
                    </div>
                </div>

                <div id="googleChecksPanel" class="analysis-panel">
                    <h3>Google Checks Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">🔍</div>
                        <p>Google check and other background verification results will be displayed here.</p>
                    </div>
                </div>

                <div id="deviationsPanel" class="analysis-panel">
                    <h3>Deviations</h3>
                    <div class="placeholder-content">
                        <div class="icon">⚠️</div>
                        <p>Policy deviations identified in the case will be displayed here.</p>
                    </div>
                </div>

                <div id="concernsPanel" class="analysis-panel">
                    <h3>Concerns in the Case</h3>
                    <div class="placeholder-content">
                        <div class="icon">🚨</div>
                        <p>Key concerns and risk factors will be displayed here.</p>
                    </div>
                </div>

                <div id="strengthsPanel" class="analysis-panel">
                    <h3>Strengths of the Case</h3>
                    <div class="placeholder-content">
                        <div class="icon">💪</div>
                        <p>Key strengths and positive factors will be displayed here.</p>
                    </div>
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="form-actions">
                <a href="/stage2/<%= proposal.id %>" class="btn btn-secondary">Back to Documents</a>
            </div>
        </div>
    </div>

    <script>
        const proposalId = '<%= proposal.id %>';

        // Refresh EMI tracking by reprocessing bank statements
        async function refreshEmiTracking() {
            const btn = event.target;
            const originalText = btn.innerHTML;
            
            btn.innerHTML = '⏳ Processing...';
            btn.disabled = true;
            
            try {
                const response = await fetch(`/stage2/${proposalId}/reprocess-banking`, {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(`EMI tracking refreshed! Processed ${result.processedCount} bank statement(s).`);
                    location.reload();
                } else {
                    alert('Error: ' + (result.error || 'Failed to refresh EMI tracking'));
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (error) {
                alert('Error refreshing EMI tracking: ' + error.message);
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // Main Tab Switching (CAM / Analysis)
        function showMainTab(tab) {
            // Update tab buttons
            document.querySelectorAll('.main-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');

            // Update tab content
            document.querySelectorAll('.main-tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById(tab + 'Tab').classList.add('active');
        }

        // Analysis Sub-tab Switching
        function showAnalysisTab(tab) {
            // Update sub-tab buttons
            document.querySelectorAll('.analysis-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');

            // Update panel content
            document.querySelectorAll('.analysis-panel').forEach(p => p.classList.remove('active'));
            document.getElementById(tab + 'Panel').classList.add('active');
        }

        // Navigate from CAM table to Analysis tab
        function goToAnalysis(tab) {
            // Switch to Analysis main tab
            document.querySelectorAll('.main-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.main-tab')[1].classList.add('active'); // Analysis is second tab

            document.querySelectorAll('.main-tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById('analysisTab').classList.add('active');

            // Switch to specific sub-tab
            document.querySelectorAll('.analysis-tab').forEach(t => t.classList.remove('active'));
            // Find and activate the matching tab button
            const tabButtons = document.querySelectorAll('.analysis-tab');
            tabButtons.forEach(btn => {
                if (btn.textContent.toLowerCase().replace(/\s+/g, '') === tab.toLowerCase() ||
                    btn.onclick.toString().includes("'" + tab + "'")) {
                    btn.classList.add('active');
                }
            });

            // Show the panel
            document.querySelectorAll('.analysis-panel').forEach(p => p.classList.remove('active'));
            const panel = document.getElementById(tab + 'Panel');
            if (panel) {
                panel.classList.add('active');
            }

            // Scroll to top of analysis section
            document.getElementById('analysisTab').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Fetch business summary from website
        async function fetchBusinessSummary() {
            const btn = document.getElementById('fetchBusinessBtn');
            const status = document.getElementById('fetchBusinessStatus');
            const statusPanel = document.getElementById('fetchBusinessStatusPanel');
            if (btn) { btn.disabled = true; btn.textContent = 'Fetching...'; }
            if (status) status.textContent = 'Fetching website and generating summary...';
            if (statusPanel) statusPanel.textContent = 'Fetching website and generating summary...';

            try {
                const response = await fetch(`/stage3/${proposalId}/fetch-business-summary`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();
                if (result.success) {
                    // Update the memo content in CAM row
                    const memoEl = document.getElementById('businessProcessMemo');
                    if (memoEl) memoEl.textContent = result.summary;
                    // Update the analysis panel content
                    const summaryEl = document.getElementById('businessSummaryContent');
                    if (summaryEl) summaryEl.innerHTML = '<p style="white-space: pre-wrap;">' + result.summary.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>';
                    if (status) status.textContent = 'Summary generated successfully!';
                    if (statusPanel) statusPanel.textContent = 'Summary generated successfully!';
                    if (status) status.style.color = '#27ae60';
                    if (statusPanel) statusPanel.style.color = '#27ae60';
                } else {
                    if (status) { status.textContent = 'Error: ' + result.error; status.style.color = '#e74c3c'; }
                    if (statusPanel) { statusPanel.textContent = 'Error: ' + result.error; statusPanel.style.color = '#e74c3c'; }
                }
            } catch (err) {
                if (status) { status.textContent = 'Error: ' + err.message; status.style.color = '#e74c3c'; }
                if (statusPanel) { statusPanel.textContent = 'Error: ' + err.message; statusPanel.style.color = '#e74c3c'; }
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'Fetch from Website'; }
            }
        }

        // Re-extract turnover documents (for incomplete data warning)
        async function reExtractTurnover() {
            const btn = event.target;
            btn.disabled = true;
            btn.textContent = 'Extracting...';

            try {
                const response = await fetch(`/stage2/${proposalId}/extract-turnover`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.success) {
                    alert(`Successfully re-extracted ${data.count} documents. Refreshing page...`);
                    window.location.reload();
                } else {
                    alert('Error: ' + data.message);
                    btn.disabled = false;
                    btn.textContent = 'Re-extract Documents';
                }
            } catch (err) {
                alert('Error re-extracting documents: ' + err.message);
                btn.disabled = false;
                btn.textContent = 'Re-extract Documents';
            }
        }

        // Re-extract financial documents (ITR/P&L/BS) and reload CAM
        async function reExtractFinancials() {
            const btn = document.getElementById('reExtractFinBtn');
            const status = document.getElementById('reExtractFinStatus');
            const icon = document.getElementById('reExtractFinIcon');
            btn.disabled = true;
            icon.style.display = 'inline-block';
            icon.style.animation = 'spin 1s linear infinite';
            status.textContent = 'Re-extracting financial documents...';

            try {
                const response = await fetch(`/stage3/${proposalId}/reextract-financials`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.success) {
                    status.style.color = '#27ae60';
                    status.textContent = 'Extracted ' + data.processedCount + ' docs. Reloading...';
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    status.style.color = '#e74c3c';
                    status.textContent = 'Error: ' + (data.error || 'Unknown error');
                    btn.disabled = false;
                    icon.style.animation = '';
                }
            } catch (err) {
                status.style.color = '#e74c3c';
                status.textContent = 'Error: ' + err.message;
                btn.disabled = false;
                icon.style.animation = '';
            }
        }

        // Refresh turnover data (for newly uploaded GST returns)
        async function refreshTurnoverData() {
            const btn = document.getElementById('refreshTurnoverBtn');
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span style="font-size: 1.1em;">&#8635;</span> Refreshing...';

            try {
                const response = await fetch(`/stage2/${proposalId}/extract-turnover`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.success) {
                    btn.innerHTML = '<span style="font-size: 1.1em;">&#10003;</span> Done!';
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                } else {
                    alert('Error: ' + data.message);
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                }
            } catch (err) {
                alert('Error refreshing data: ' + err.message);
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }
        }

        // Store server-side values for client-side use
        const serverData = {
            plSales2324: <%= proposal.turnoverData?.fy2324 || 0 %>,
            plSales2425: <%= proposal.turnoverData?.fy2425 || 0 %>,
            projectedTurnover: <%= typeof projectedTurnover !== 'undefined' ? projectedTurnover : 0 %>
        };

        // Save P&L Sales turnover data
        async function saveTurnoverData() {
            const btn = document.getElementById('saveTurnoverBtn');
            const fy2324Input = document.getElementById('plSales2324');
            const fy2425Input = document.getElementById('plSales2425');

            const fy2324 = fy2324Input ? parseFloat(fy2324Input.value) || 0 : serverData.plSales2324;
            const fy2425 = fy2425Input ? parseFloat(fy2425Input.value) || 0 : serverData.plSales2425;

            if (fy2324 === 0 && fy2425 === 0) {
                alert('Please enter at least one P&L sales value');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Saving...';

            try {
                const response = await fetch(`/stage3/${proposalId}/save-turnover-data`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fy2324, fy2425 })
                });
                const data = await response.json();

                if (data.success) {
                    btn.textContent = 'Saved!';
                    btn.style.background = '#27ae60';
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                } else {
                    alert('Error: ' + data.message);
                    btn.disabled = false;
                    btn.textContent = 'Save P&L Sales Data';
                }
            } catch (err) {
                alert('Error saving data: ' + err.message);
                btn.disabled = false;
                btn.textContent = 'Save P&L Sales Data';
            }
        }

        // Auto-populate Banking Details in CAM from Banking Analysis panel
        document.addEventListener('DOMContentLoaded', function() {
            const bankingMemoDiv = document.getElementById('bankingDetailsMemo');
            if (!bankingMemoDiv) return;

            const bankingPanel = document.getElementById('bankingPanel');
            if (!bankingPanel) return;

            const accountBlocks = bankingPanel.querySelectorAll('div[style*="border-left: 4px solid #3498db"]');
            if (accountBlocks.length === 0) return;

            const thStyle = 'padding: 5px 8px; border: 1px solid #bbdefb; text-align: left; font-size: 0.85em;';
            const thRightStyle = 'padding: 5px 8px; border: 1px solid #bbdefb; text-align: right; font-size: 0.85em;';
            const tdStyle = 'padding: 4px 8px; border: 1px solid #e0e0e0; font-size: 0.85em;';
            const tdRightStyle = 'padding: 4px 8px; border: 1px solid #e0e0e0; text-align: right; font-size: 0.85em;';
            const totalTdStyle = 'padding: 4px 8px; border: 1px solid #e0e0e0; font-size: 0.85em; font-weight: 700; background: #e8f5e9;';
            const totalTdRightStyle = 'padding: 4px 8px; border: 1px solid #e0e0e0; text-align: right; font-size: 0.85em; font-weight: 700; background: #e8f5e9;';
            const sectionHead = (text) => `<strong style="color: #1565c0; font-size: 0.9em;">${text}</strong>`;

            let html = '';

            accountBlocks.forEach((block, idx) => {
                const h4 = block.querySelector('h4');
                const acNo = h4 ? (h4.querySelector('span') || {}).textContent || '' : '';
                const namePara = block.querySelector('p[style*="color: #666"]');
                const acName = namePara ? namePara.textContent.replace('Account Name:', '').trim() : '';

                if (idx > 0) html += '<hr style="border: none; border-top: 1px solid #ccc; margin: 12px 0;">';

                html += `<div style="margin-bottom: 12px; padding: 8px; background: #f0f7ff; border-radius: 6px; border-left: 3px solid #3498db;">`;
                html += `<strong style="color: #2c3e50;">A/C No: ${acNo}</strong>`;
                if (acName) html += `<span style="color: #666; margin-left: 8px;">(${acName})</span>`;
                html += `</div>`;

                const tables = block.querySelectorAll('table');

                // Helper to extract rows from a table
                function getTableData(table) {
                    const data = [];
                    table.querySelectorAll('tbody tr').forEach(row => {
                        const cells = row.querySelectorAll('td');
                        data.push(Array.from(cells).map(c => c.textContent.trim()));
                    });
                    return data;
                }

                // 1. Combined Credits & Debits table
                if (tables.length >= 2) {
                    const creditRows = getTableData(tables[0]);
                    const debitRows = getTableData(tables[1]);

                    html += `<div style="margin-bottom: 10px;">`;
                    html += sectionHead('Monthly Credits & Debits');
                    html += `<table style="width: 100%; border-collapse: collapse; margin-top: 5px;">`;
                    html += `<thead><tr style="background: #e3f2fd;">`;
                    html += `<th style="${thStyle}">Month</th>`;
                    html += `<th style="${thRightStyle}">Credits (Rs.)</th>`;
                    html += `<th style="${thRightStyle}">Debits (Rs.)</th>`;
                    html += `</tr></thead><tbody>`;

                    // Build month map from credits
                    const months = [];
                    let totalCr = '', totalDr = '';
                    creditRows.forEach(r => {
                        if (r[0] === 'Total') { totalCr = r[1]; return; }
                        if (r.length >= 2) months.push({ month: r[0], credit: r[1] });
                    });
                    // Map debits by index
                    const debitMap = {};
                    debitRows.forEach(r => {
                        if (r[0] === 'Total') { totalDr = r[1]; return; }
                        debitMap[r[0]] = r[1];
                    });

                    months.forEach((m, i) => {
                        const bg = i % 2 === 0 ? '#fff' : '#f5f9ff';
                        html += `<tr style="background: ${bg};">`;
                        html += `<td style="${tdStyle}">${m.month}</td>`;
                        html += `<td style="${tdRightStyle}">${m.credit}</td>`;
                        html += `<td style="${tdRightStyle}">${debitMap[m.month] || '-'}</td>`;
                        html += `</tr>`;
                    });
                    // Also add debit-only months not in credits
                    Object.keys(debitMap).forEach(dm => {
                        if (!months.find(m => m.month === dm)) {
                            html += `<tr><td style="${tdStyle}">${dm}</td><td style="${tdRightStyle}">-</td><td style="${tdRightStyle}">${debitMap[dm]}</td></tr>`;
                        }
                    });

                    html += `<tr><td style="${totalTdStyle}">Total</td>`;
                    html += `<td style="${totalTdRightStyle}">${totalCr}</td>`;
                    html += `<td style="${totalTdRightStyle}">${totalDr}</td>`;
                    html += `</tr></tbody></table></div>`;
                }

                // 2. Average Daily Balances (4th table)
                if (tables.length >= 4) {
                    const avgRows = getTableData(tables[3]);
                    html += `<div style="margin-bottom: 10px;">`;
                    html += sectionHead('Average Daily Balance');
                    html += `<table style="width: 100%; border-collapse: collapse; margin-top: 5px;">`;
                    html += `<thead><tr style="background: #e3f2fd;">`;
                    html += `<th style="${thStyle}">Month</th>`;
                    html += `<th style="${thRightStyle}">Avg. Balance (Rs.)</th>`;
                    html += `</tr></thead><tbody>`;

                    avgRows.forEach((r, i) => {
                        if (r.length < 2) return;
                        const isTotal = r[0] === 'Overall Average';
                        const style = isTotal ? totalTdStyle : tdStyle;
                        const styleR = isTotal ? totalTdRightStyle : tdRightStyle;
                        const bg = isTotal ? '' : (i % 2 === 0 ? ' background: #fff;' : ' background: #f5f9ff;');
                        html += `<tr style="${bg}"><td style="${style}">${r[0]}</td><td style="${styleR}">${r[1]}</td></tr>`;
                    });

                    html += `</tbody></table></div>`;
                }

                // 3. Adverse Observations (5th table)
                if (tables.length >= 5) {
                    const advRows = getTableData(tables[4]);
                    html += `<div style="margin-bottom: 10px;">`;
                    html += sectionHead('Adverse Observations');
                    html += `<table style="width: 100%; border-collapse: collapse; margin-top: 5px;">`;
                    html += `<thead><tr style="background: #fce4ec;">`;
                    html += `<th style="padding: 5px 8px; border: 1px solid #f8bbd0; text-align: left; font-size: 0.85em;">Particulars</th>`;
                    html += `<th style="padding: 5px 8px; border: 1px solid #f8bbd0; text-align: right; font-size: 0.85em;">Inward</th>`;
                    html += `<th style="padding: 5px 8px; border: 1px solid #f8bbd0; text-align: right; font-size: 0.85em;">Outward</th>`;
                    html += `</tr></thead><tbody>`;

                    advRows.forEach(r => {
                        if (r.length < 3) return;
                        const hasIssue = r[1] !== '0' || r[2] !== '0';
                        const color = hasIssue ? ' color: #c62828; font-weight: 600;' : '';
                        html += `<tr><td style="${tdStyle}">${r[0]}</td>`;
                        html += `<td style="${tdRightStyle}${color}">${r[1]}</td>`;
                        html += `<td style="${tdRightStyle}${color}">${r[2]}</td></tr>`;
                    });

                    html += `</tbody></table></div>`;
                }
            });

            if (html) {
                bankingMemoDiv.innerHTML = html;
            }
        });

        // Update growth percentages dynamically when P&L values change
        document.addEventListener('DOMContentLoaded', function() {
            const fy2324Input = document.getElementById('plSales2324');
            const fy2425Input = document.getElementById('plSales2425');
            const projectedTurnover = serverData.projectedTurnover;

            function updateGrowthDisplay() {
                const fy2324 = fy2324Input ? parseFloat(fy2324Input.value) || 0 : 0;
                const fy2425 = fy2425Input ? parseFloat(fy2425Input.value) || 0 : 0;

                // Update FY2024-25 growth
                const growth2425Cell = document.getElementById('growth2425Cell');
                if (growth2425Cell && fy2324 > 0 && fy2425 > 0) {
                    const growth = ((fy2425 - fy2324) / fy2324) * 100;
                    growth2425Cell.textContent = (growth >= 0 ? '+' : '') + growth.toFixed(1) + '%';
                    growth2425Cell.style.color = growth >= 0 ? '#27ae60' : '#e74c3c';
                }

                // Update FY2025-26 growth
                const growth2526Cell = document.getElementById('growth2526Cell');
                if (growth2526Cell && fy2425 > 0 && projectedTurnover > 0) {
                    const growth = ((projectedTurnover - fy2425) / fy2425) * 100;
                    growth2526Cell.textContent = (growth >= 0 ? '+' : '') + growth.toFixed(1) + '%';
                    growth2526Cell.style.color = growth >= 0 ? '#27ae60' : '#e74c3c';
                }
            }

            if (fy2324Input) fy2324Input.addEventListener('input', updateGrowthDisplay);
            if (fy2425Input) fy2425Input.addEventListener('input', updateGrowthDisplay);
        });
    </script>
</body>
</html>
