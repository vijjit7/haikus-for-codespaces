                </div>

                <div id="otherIncomePanel" class="analysis-panel">
                    <h3>Other Income Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">💵</div>
                        <p>Other income sources like rentals will be displayed here.</p>
                    </div>
                </div>

                <div id="bankingPanel" class="analysis-panel">
                    <h3>Banking Analysis</h3>
                    
                    <%
                    // Get group/related company names for inter-group deposit detection
                    const groupEntities = [];
                    const applicantNameForGroup = (proposal.applicantName || '').toUpperCase().trim();
                    if (applicantNameForGroup) {
                        groupEntities.push(applicantNameForGroup);
                        // Add common variations (without PRIVATE LIMITED, etc.)
                        const shortName = applicantNameForGroup.replace(/(PRIVATE|LIMITED|LTD|PVT|LLP|LLC|INC|CORP|CORPORATION)/gi, '').trim();
                        if (shortName && shortName.length > 3) groupEntities.push(shortName);
                    }
                    // Add from shareholders list if available (for related party detection)
                    const shareholdersDoc = (proposal.documents || []).find(d => d.classification && d.classification.toLowerCase().includes('shareholder'));
                    if (shareholdersDoc && shareholdersDoc.parsedData && shareholdersDoc.parsedData.shareholders) {
                        shareholdersDoc.parsedData.shareholders.forEach(sh => {
                            if (sh.name) groupEntities.push(sh.name.toUpperCase().trim());
                        });
                    }
                    
                    // Get banking documents
                    const bankingDocsForAnalysis = (proposal.documents || []).filter(d => d.category === 'banking');
                    
                    // Group by account number
                    const accountsMap = {};
                    
                    bankingDocsForAnalysis.forEach(doc => {
                        const text = doc.extractedText || '';
                        
                        // Extract account number - support multiple formats
                        let acNo = 'Unknown';
                        const acNoPatterns = [
                            /A\/C No[:\s]*(\d+)/i,                    // A/C No: 123456
                            /Account No[:\s]*[:]?\s*(\d+)/i,           // Account No: 123456
                            /Account Number[:\s]*[:]?\s*(\d+)/i,       // Account Number: 123456
                            /Acct No[:\s]*(\d+)/i,                     // Acct No: 123456
                            /A\/c[:\s]*(\d{9,18})/i,                   // A/c 123456789012
                            /Account[:\s]*(\d{9,18})/i                 // Account 123456789012
                        ];
                        for (const pattern of acNoPatterns) {
                            const match = text.match(pattern);
                            if (match) {
                                acNo = match[1];
                                break;
                            }
                        }
                        
                        // If text-based detection failed, use extractedDetails.accountNumber
                        if (acNo === 'Unknown' && doc.extractedDetails && doc.extractedDetails.accountNumber && doc.extractedDetails.accountNumber !== 'N/A') {
                            acNo = doc.extractedDetails.accountNumber;
                        }
                        // Also try extractedDetails.last4Digits to use a consistent short identifier for masked accounts
                        if (acNo === 'Unknown' && doc.extractedDetails && doc.extractedDetails.last4Digits) {
                            acNo = 'XXXX' + doc.extractedDetails.last4Digits;
                        }
                        // Last resort: use document id
                        if (acNo === 'Unknown' && doc._id) {
                            acNo = 'Doc-' + doc._id.toString().slice(-6);
                        }

                        // Merge accounts with same last 4 digits (e.g. XXXXXXX4254 and 85132944254 are the same account)
                        const currentLast4 = (doc.extractedDetails && doc.extractedDetails.last4Digits) || acNo.replace(/\D/g, '').slice(-4);
                        if (currentLast4 && currentLast4.length >= 4) {
                            const last4 = currentLast4.slice(-4);
                            for (const existingKey of Object.keys(accountsMap)) {
                                if (existingKey === acNo) continue;
                                const existingLast4 = existingKey.replace(/\D/g, '').slice(-4);
                                if (existingLast4 === last4) {
                                    acNo = existingKey; // Merge into existing group
                                    break;
                                }
                            }
                        }

                        // Extract account name
                        const nameMatch = text.match(/Name[:\s]*([A-Z][^\n]+)/i);
                        const acName = nameMatch ? nameMatch[1].replace(/\(FORMERLY[\s\S]*?\)/gi, '').trim() : doc.classification || 'Unknown';
                        
                        // Extract period
                        const periodMatch = text.match(/(?:Transaction Period|From)\s*[:\s]*(\d{2}\/\d{2}\/\d{4})\s*(?:To|-)\s*(\d{2}\/\d{2}\/\d{4})/i);
                        
                        if (!accountsMap[acNo]) {
                            accountsMap[acNo] = {
                                accountNo: acNo,
                                accountName: acName,
                                documents: [],
                                allText: ''
                            };
                        }
                        accountsMap[acNo].documents.push(doc);
                        accountsMap[acNo].allText += text + '\n';
                    });
                    
                    // For each account, parse transactions and compute analysis
                    const accountAnalysis = {};

                    // Helper: expand 2-digit year to 4-digit (25 → 2025, 99 → 1999)
                    const expandYear = (yy) => {
                        const num = parseInt(yy);
                        return String(num < 50 ? 2000 + num : 1900 + num);
                    };

                    Object.keys(accountsMap).forEach(acNo => {
                        const account = accountsMap[acNo];
                        let text = account.allText;
                        
                        // Normalize text: join split amounts (amounts broken by newlines like "1,29,930.\n00")
                        text = text.replace(/([\d,]+\.)\s*\n\s*(\d{2})\b/g, '$1$2');
                        text = text.replace(/([\d,]+)\s*\n\s*(,\d{3})/g, '$1$2');
                        
                        // Normalize dates: join split dates (dates broken by newlines like "01/Dec/20\n25" or "01-Nov-20\n25")
                        text = text.replace(/(\d{2})[\/\-](\w{3})[\/\-](\d{2})\s*\n\s*(\d{2})\b/gi, '$1-$2-$3$4');
                        text = text.replace(/(\d{2})\s*\n\s*[\/\-](\w{3})[\/\-](\d{4})/gi, '$1-$2-$3');
                        
                        // Parse transactions - look for date, particulars, debit, credit, balance patterns
                        const transactions = [];
                        const monthlyCredits = {};
                        const monthlyDebits = {};
                        const monthlyBalances = {};
                        const bulkCredits = [];
                        let inwardReturns = 0;
                        let outwardReturns = 0;
                        let emiBounces = 0;
                        
                        // Inter-group deposit tracking
                        const monthlyInterGroupCredits = {};
                        const monthlyInterGroupDebits = {};
                        
                        // Helper function to check if transaction is inter-group
                        const isInterGroupTransaction = (particulars) => {
                            if (!particulars) return false;
                            const upperParticulars = particulars.toUpperCase();
                            return groupEntities.some(entity => {
                                if (!entity || entity.length < 4) return false;
                                return upperParticulars.includes(entity);
                            });
                        };
                        
                        // Simple approach: scan for amounts following dates
                        // Group credits by month
                        const monthCreditsTotal = {};
                        const monthDebitsTotal = {};
                        let allCredits = [];
                        
                        // NEW APPROACH: Parse ICICI bank statement format
                        // Look for transaction rows with date, description, and amounts
                        // Format: Date (dd/Mon/yyyy) ... Description ... Amount ... Balance
                        
                        // First, find all amounts in the text with their positions
                        // Match amounts with decimal places (money format like 8,000.00 or 6,00,000.00)
                        const amountRegex = /([\d,]+\.\d{2})/g;
                        let amountMatch;
                        const amounts = [];
                        while ((amountMatch = amountRegex.exec(text)) !== null) {
                            const valStr = amountMatch[1].replace(/,/g, '');
                            const val = parseFloat(valStr);
                            if (val > 0 && val < 1000000000) {
                                amounts.push({
                                    value: val,
                                    str: amountMatch[1],
                                    index: amountMatch.index
                                });
                            }
                        }
                        
                        // Find all transaction dates - support multiple formats
                        // Format 1: dd/Mon/yyyy (e.g., 20/Nov/2025)
                        // Format 2: dd/mm/yyyy (e.g., 20/11/2025)
                        // Format 3: dd-mm-yyyy (e.g., 20-11-2025)
                        const txnDates = [];
                        
                        // Pattern for dd/Mon/yyyy or dd-Mon-yyyy format
                        const txnDateRegex1 = /(\d{2})[\/\-](\w{3})[\/\-](\d{4})/gi;
                        let dateMatch;
                        while ((dateMatch = txnDateRegex1.exec(text)) !== null) {
                            const monthNamesMap = {jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06', 
                                               jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12'};
                            const monthNum = monthNamesMap[dateMatch[2].toLowerCase()] || '01';
                            txnDates.push({
                                dateStr: dateMatch[0],
                                day: dateMatch[1],
                                month: dateMatch[2],
                                monthNum: monthNum,
                                year: dateMatch[3],
                                monthKey: monthNum + '-' + dateMatch[3],
                                index: dateMatch.index
                            });
                        }
                        
                        // Pattern for dd/mm/yyyy or dd-mm-yyyy format (numeric month)
                        // Skip dates that appear to be timestamps (followed by time pattern)
                        const txnDateRegex2 = /(\d{2})[\/\-](\d{2})[\/\-](\d{4})(?!\s*\d{2}:\d{2})/g;
                        while ((dateMatch = txnDateRegex2.exec(text)) !== null) {
                            // Check if this position was already captured by format 1 or is very close to another date
                            const alreadyExists = txnDates.some(d => Math.abs(d.index - dateMatch.index) < 15);
                            if (!alreadyExists) {
                                const monthNum = dateMatch[2]; // Already in mm format
                                const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                txnDates.push({
                                    dateStr: dateMatch[0],
                                    day: dateMatch[1],
                                    month: monthNames[parseInt(monthNum)] || monthNum,
                                    monthNum: monthNum,
                                    year: dateMatch[3],
                                    monthKey: monthNum + '-' + dateMatch[3],
                                    index: dateMatch.index
                                });
                            }
                        }
                        
                        // Pattern for dd/mm/yy or dd-mm-yy format (2-digit year, e.g. HDFC: 02/01/25)
                        const txnDateRegex3 = /(\d{2})[\/\-](\d{2})[\/\-](\d{2})(?!\d)/g;
                        while ((dateMatch = txnDateRegex3.exec(text)) !== null) {
                            const alreadyExists = txnDates.some(d => Math.abs(d.index - dateMatch.index) < 15);
                            if (!alreadyExists) {
                                const monthNum = dateMatch[2];
                                const year = expandYear(dateMatch[3]);
                                const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                txnDates.push({
                                    dateStr: dateMatch[0],
                                    day: dateMatch[1],
                                    month: monthNames[parseInt(monthNum)] || monthNum,
                                    monthNum: monthNum,
                                    year: year,
                                    monthKey: monthNum + '-' + year,
                                    index: dateMatch.index
                                });
                            }
                        }

                        // Pattern for dd/Mon/yy or dd-Mon-yy format (2-digit year, e.g. 02/Jan/25 or 02-Jan-25)
                        const txnDateRegex4 = /(\d{2})[\/\-](\w{3})[\/\-](\d{2})(?!\d)/gi;
                        while ((dateMatch = txnDateRegex4.exec(text)) !== null) {
                            const alreadyExists = txnDates.some(d => Math.abs(d.index - dateMatch.index) < 15);
                            if (!alreadyExists) {
                                const monthNamesMap = {jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06',
                                                   jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12'};
                                const monthNum = monthNamesMap[dateMatch[2].toLowerCase()] || '01';
                                const year = expandYear(dateMatch[3]);
                                txnDates.push({
                                    dateStr: dateMatch[0],
                                    day: dateMatch[1],
                                    month: dateMatch[2],
                                    monthNum: monthNum,
                                    year: year,
                                    monthKey: monthNum + '-' + year,
                                    index: dateMatch.index
                                });
                            }
                        }

                        // Sort by index position in text
                        txnDates.sort((a, b) => a.index - b.index);
                        
                        // Look for deposit/credit patterns - amounts near transaction keywords
                        // ICICI format has Deposit (Cr) column, look for credits
                        // Note: INF/NEFT/RTGS/IMPS can be both incoming (credit) or outgoing (debit)
                        // So we rely on DR/CR indicator first, then use these as hints
                        // Keywords that ONLY indicate credit (incoming)
                        const creditKeywords = ['BY ', 'CREDIT', 'DEPOSIT', 'TO A/C', 'INT.PD', 'INTEREST PAID'];
                        // Keywords that ONLY indicate debit (outgoing)
                        // Note: removed 'MPS/' and 'IPS/' - they match inside 'IMPS/' which can be credit or debit
                        const debitKeywords = ['BIL/', 'GIB/', 'ATM/', 'CAM/', 'NFS/', 'ACH', 'EMI', 'NACH', 'BIL/ONL', 'Chg', 'FROM A/C', 'DEBIT', 'WITHDRAW', 'TPT'];
                        // Ambiguous keywords - can be either credit or debit (NEFT/RTGS/IMPS/UPI etc.)
                        // These should NOT determine debit/credit on their own

                        const seenCredits = new Set();
                        const seenDebits = new Set();

                        // Track running balance for balance-direction detection
                        let previousBalance = null;

                        // Track daily balances for average calculation
                        const dailyBalances = {}; // key: date string, value: balance amount
                        const monthlyBalanceSums = {}; // key: monthKey, value: {sum, count}
                        
                        // NEW APPROACH: Parse line by line instead of date-to-date
                        // This handles cases where dates appear multiple times per row
                        const rawLines = text.split(/\n/);
                        
                        // PRE-PROCESS: Join multi-line transactions into single lines
                        // Bank statements often split: date on one line, particulars on next, amounts on another
                        // Strategy: A new transaction STARTS when we see a line with a date pattern
                        // Keep collecting lines until we have both date AND amounts, then push
                        const lines = [];
                        let currentTxnLine = '';
                        let currentHasDate = false;
                        
                        // Helper: check if line has a transaction date pattern
                        const lineHasDate = (line) => {
                            return /\d{2}[\/\-]\d{2}[\/\-]\d{4}/.test(line) || /\d{2}[\/\-]\w{3}[\/\-]\d{4}/i.test(line) ||
                                   /\d{2}[\/\-]\d{2}[\/\-]\d{2}(?!\d)/.test(line) || /\d{2}[\/\-]\w{3}[\/\-]\d{2}(?!\d)/i.test(line) ||
                                   /\d{2}\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+\d{4}/i.test(line);
                        };
                        
                        // Helper: check if line has amount patterns
                        const lineHasAmounts = (line) => {
                            return /\d{1,3}(,\d{2,3})*\.\d{2}/.test(line) || /\d{1,2},\d{2},\d{3}/.test(line);
                        };
                        
                        // Helper: check if line is a header/footer/summary to skip
                        const isHeaderFooter = (line) => {
                            return /^\s*(Date|Particulars|Debit|Credit|Balance|Opening\s*Bal|Closing\s*Bal|Total|Page\s*Total|Page\s*\d|Statement|From\s+\d|Period|Account|Withdrawl|Withdrawal|Deposit[s:]|Legends|IFSC|Branch|Cust\s*ID|Cheque\s*number|Chq\s*No|Transaction\s*(type|remarks|Period)|Amount\s*from|Advanced\s*Search|Sl\s*No|Tran\s*Id|Value\s*Date|Posted\s*Date|Ref\s*No|Nomination\s*Registered|Product\s*Description|Email\s*Id|Mobile\s*No|PAN:|Holding\s*Status|Customer\s*(ID|Details)|Relationship\s*Summary|Account\s*(No|Type|Summary|Number)|Currency|Lien\s*Amount|Name$)/i.test(line);
                        };
                        
                        // Track whether we're in a summary section (Page Total, etc.)
                        let inSummarySection = false;

                        rawLines.forEach((line, idx) => {
                            const trimmedLine = line.trim();
                            if (!trimmedLine) return; // Skip empty lines

                            // Check if this line is a header/footer/summary
                            const isSummaryLine = isHeaderFooter(trimmedLine);

                            if (isSummaryLine) {
                                // Finalize any in-progress transaction before skipping
                                if (currentTxnLine && currentHasDate && lineHasAmounts(currentTxnLine)) {
                                    lines.push(currentTxnLine);
                                }
                                currentTxnLine = '';
                                currentHasDate = false;
                                inSummarySection = true; // Mark that we're in a summary section
                                return;
                            }

                            // If we're in a summary section, skip lines until a new transaction starts
                            if (inSummarySection) {
                                const hasDate = lineHasDate(trimmedLine);
                                const startsNew = /^\s*(\d{1,4}\s+)?\d{2}[\/\-](\d{2}|\w{3})[\/\-]\d{2,4}/.test(trimmedLine) ||
                                                  /^[A-Z]\d{1,6}[\/\s]/.test(trimmedLine) ||
                                                  /^\s*\d{2}\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+\d{4}/i.test(trimmedLine);
                                if (startsNew) {
                                    inSummarySection = false;
                                    // Fall through to start new transaction below
                                } else {
                                    return; // Skip summary data lines (amounts after Page Total, etc.)
                                }
                            }

                            const hasDate = lineHasDate(trimmedLine);
                            const hasAmounts = lineHasAmounts(trimmedLine);

                            // A new transaction starts when a date appears near the START of the line
                            // This prevents ref number lines like "0000002883295641 02/01/25" or "N002253488208726 02/01/25" from splitting transactions
                            // Allows optional 1-4 digit serial number before the date (SBI format)
                            const startsNewTxn = /^\s*(\d{1,4}\s+)?\d{2}[\/\-](\d{2}|\w{3})[\/\-]\d{2,4}/.test(trimmedLine) ||
                                                 /^[A-Z]\d{1,6}[\/\s]/.test(trimmedLine) || // ICICI S123/M456 format (letter + short number)
                                                 /^\s*\d{2}\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+\d{4}/i.test(trimmedLine); // IndusInd: "03 Jan 2026"

                            if (startsNewTxn) {
                                // Save previous transaction if it has both date and amounts
                                if (currentTxnLine && currentHasDate && lineHasAmounts(currentTxnLine)) {
                                    lines.push(currentTxnLine);
                                }
                                // Start new transaction
                                currentTxnLine = trimmedLine;
                                currentHasDate = true;
                            } else if (currentTxnLine) {
                                // Continuation - append to current transaction
                                currentTxnLine += ' ' + trimmedLine;
                                // Check if we now have a complete transaction (date + amounts)
                                if (currentHasDate && lineHasAmounts(currentTxnLine)) {
                                    // Count how many amount-like patterns are in the merged line
                                    const amtCount = (currentTxnLine.match(/\d{1,3}(?:,\d{2,3})*\.\d{2}/g) || []).length;
                                    // A complete transaction has at least 2 amounts (transaction + balance)
                                    // Finalize if: next line starts a new txn, OR we already have 2+ amounts
                                    const nextLine = rawLines[idx + 1]?.trim() || '';
                                    const nextStartsTxn = /^\s*(\d{1,4}\s+)?\d{2}[\/\-](\d{2}|\w{3})[\/\-]\d{2,4}/.test(nextLine) || /^[A-Z]\d{1,6}[\/\s]/.test(nextLine) || /^\s*\d{2}\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+\d{4}/i.test(nextLine);
                                    if (nextStartsTxn || amtCount >= 2) {
                                        lines.push(currentTxnLine);
                                        currentTxnLine = '';
                                        currentHasDate = false;
                                    }
                                }
                            } else if (hasAmounts && !hasDate) {
                                // Standalone line with amounts but no date - might be a different format
                                // Skip for now, or add as-is if it looks valid
                            }
                        });
                        
                        // Don't forget the last transaction
                        if (currentTxnLine && currentHasDate && lineHasAmounts(currentTxnLine)) {
                            lines.push(currentTxnLine);
                        }
                        
                        const mergedLineCount = lines.length;
                        const rawLineCount = rawLines.length;
                        
                        let linesWithDates = 0;
                        let linesWithAmounts = 0;
                        let linesWithDRCR = 0;
                        let creditLines = 0;
                        let debitLines = 0;
                        let columnarDetections = 0; // Count lines detected via columnar format (Debit|Credit|Balance)
                        const sampleLines = []; // Collect first 3 sample lines with dates for debugging

                        // Try to extract opening balance from raw text (before transaction loop)
                        // Common patterns: "Opening Balance: 1,23,456.78" or "B/F 1,23,456.78"
                        const obMatch = text.match(/(?:opening\s*balance|b\/f|brought\s*forward)[:\s]*([\d,]+\.\d{2})/i);
                        if (obMatch) {
                            previousBalance = parseFloat(obMatch[1].replace(/,/g, ''));
                        }

                        lines.forEach(line => {
                            // Special handling for Int.Coll lines: use the "to" date as transaction date
                            // e.g. "720305000315:Int.Coll:02-12-2025 to 01-01-2026" → use 01-01-2026
                            let dateSearchLine = line;
                            const intCollMatch = line.match(/Int\.Coll.*?to\s+(\d{2})[\/\-](\d{2})[\/\-](\d{2,4})/i);
                            if (intCollMatch) {
                                const icYear = intCollMatch[3].length === 2 ? expandYear(intCollMatch[3]) : intCollMatch[3];
                                dateSearchLine = intCollMatch[1] + '/' + intCollMatch[2] + '/' + icYear + ' ' + line;
                            }

                            // Find a date in this line - try 4-digit year first, then 2-digit year
                            const dateMatch1 = dateSearchLine.match(/(\d{2})[\/\-](\w{3})[\/\-](\d{4})/i);
                            const dateMatch2 = dateSearchLine.match(/(\d{2})[\/\-](\d{2})[\/\-](\d{4})/);
                            const dateMatch3 = dateSearchLine.match(/(\d{2})[\/\-](\d{2})[\/\-](\d{2})(?!\d)/);
                            const dateMatch4 = dateSearchLine.match(/(\d{2})[\/\-](\w{3})[\/\-](\d{2})(?!\d)/i);
                            const dateMatch5 = dateSearchLine.match(/(\d{2})\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+(\d{4})/i); // IndusInd: "03 Jan 2026"

                            let txnDate = null;

                            if (dateMatch5) {
                                // DD Mon YYYY with spaces (IndusInd format) - check first to avoid partial matches
                                const monthNamesMap = {jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06',
                                                   jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12'};
                                const monthNum = monthNamesMap[dateMatch5[2].toLowerCase()] || '01';
                                txnDate = {
                                    dateStr: dateMatch5[0],
                                    day: dateMatch5[1],
                                    month: dateMatch5[2],
                                    monthNum: monthNum,
                                    year: dateMatch5[3],
                                    monthKey: monthNum + '-' + dateMatch5[3]
                                };
                            } else if (dateMatch1) {
                                const monthNamesMap = {jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06',
                                                   jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12'};
                                const monthNum = monthNamesMap[dateMatch1[2].toLowerCase()] || '01';
                                txnDate = {
                                    dateStr: dateMatch1[0],
                                    day: dateMatch1[1],
                                    month: dateMatch1[2],
                                    monthNum: monthNum,
                                    year: dateMatch1[3],
                                    monthKey: monthNum + '-' + dateMatch1[3]
                                };
                            } else if (dateMatch2) {
                                const monthNum = dateMatch2[2];
                                const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                txnDate = {
                                    dateStr: dateMatch2[0],
                                    day: dateMatch2[1],
                                    month: monthNames[parseInt(monthNum)] || monthNum,
                                    monthNum: monthNum,
                                    year: dateMatch2[3],
                                    monthKey: monthNum + '-' + dateMatch2[3]
                                };
                            } else if (dateMatch3) {
                                const monthNum = dateMatch3[2];
                                const year = expandYear(dateMatch3[3]);
                                const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                txnDate = {
                                    dateStr: dateMatch3[0],
                                    day: dateMatch3[1],
                                    month: monthNames[parseInt(monthNum)] || monthNum,
                                    monthNum: monthNum,
                                    year: year,
                                    monthKey: monthNum + '-' + year
                                };
                            } else if (dateMatch4) {
                                const monthNamesMap = {jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06',
                                                   jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12'};
                                const monthNum = monthNamesMap[dateMatch4[2].toLowerCase()] || '01';
                                const year = expandYear(dateMatch4[3]);
                                txnDate = {
                                    dateStr: dateMatch4[0],
                                    day: dateMatch4[1],
                                    month: dateMatch4[2],
                                    monthNum: monthNum,
                                    year: year,
                                    monthKey: monthNum + '-' + year
                                };
                            }
                            
                            if (!txnDate) return; // Skip lines without dates
                            linesWithDates++;
                            
                            // Collect sample lines for debugging
                            if (sampleLines.length < 3) {
                                sampleLines.push(line.substring(0, 150).replace(/\s+/g, ' ').trim());
                            }
                            
                            // PRE-PROCESS: Fix malformed amounts from PDF extraction
                            // Common issues: "14,78,982 .14" should be "14,78,982.14" (space before decimal)
                            // Also: "1,00,000.00" sometimes split as "1,00,000. 00" or "1,00,000 .00"
                            let cleanedLine = line
                                .replace(/(\d)\s+\.(\d)/g, '$1.$2')  // Fix "123 .45" → "123.45"
                                .replace(/(\d)\.\s+(\d)/g, '$1.$2')  // Fix "123. 45" → "123.45"
                                .replace(/(\d),\s+(\d)/g, '$1,$2')   // Fix "1, 23" → "1,23"
                                .replace(/(\.\d{2})(\d)/g, '$1 $2') // Split concatenated amounts: "49000.0099784.89" → "49000.00 99784.89"
                                // Fix mid-number splits from PDF column overflow for crore-range amounts
                                // ICICI PDF balance column can't fit 8+ digit numbers, splits mid-number:
                                // "1,04,77,1 31.21" should be "1,04,77,131.21" (balance was 1,04,77,131.21)
                                // Pattern: Indian number with incomplete last group (1-2 digits) + space + remaining digits.decimal
                                .replace(/(\d{1,2}(?:,\d{2})+,\d{1,2})\s+(\d{1,3}\.\d{2})\b/g, '$1$2');
                            
                            // Find all amounts in this line - flexible format matching
                            // Matches: 1,23,456.78 | 123456.78 | 1,23,456 | 123456
                            const lineAmounts = [];
                            // Pattern 1: Numbers with decimals (required 2 decimal places)
                            const amtRegex1 = /\b([\d,]+\.\d{2})\b/g;
                            // Pattern 2: Large numbers without decimals (at least 3 digits, possibly with commas)
                            const amtRegex2 = /\b(\d{1,2},\d{2},\d{3})\b/g;
                            // Pattern 3: Numbers in any numeric format (used as fallback)
                            const amtRegex3 = /\b(\d[\d,]*\d)\b/g;
                            
                            let amtMatch;
                            
                            // Try pattern 1 first (with decimals)
                            while ((amtMatch = amtRegex1.exec(cleanedLine)) !== null) {
                                const val = parseFloat(amtMatch[1].replace(/,/g, ''));
                                if (val > 0 && val < 1000000000) {
                                    // Skip date-like values: "31.08" from "31.08.2025" (dd.mm.yyyy in descriptions)
                                    const afterStr = cleanedLine.substring(amtMatch.index + amtMatch[0].length, amtMatch.index + amtMatch[0].length + 5);
                                    if (/^\.\d{4}/.test(afterStr)) continue;
                                    lineAmounts.push({
                                        value: val,
                                        str: amtMatch[1],
                                        index: amtMatch.index
                                    });
                                }
                            }
                            
                            // If no decimal amounts found, try Indian format without decimals
                            if (lineAmounts.length === 0) {
                                while ((amtMatch = amtRegex2.exec(cleanedLine)) !== null) {
                                    const val = parseFloat(amtMatch[1].replace(/,/g, ''));
                                    if (val > 100 && val < 1000000000) {
                                        lineAmounts.push({
                                            value: val,
                                            str: amtMatch[1],
                                            index: amtMatch.index
                                        });
                                    }
                                }
                            }
                            
                            // Final fallback: find numbers that look like amounts (> 3 digits)
                            if (lineAmounts.length === 0) {
                                while ((amtMatch = amtRegex3.exec(cleanedLine)) !== null) {
                                    const val = parseFloat(amtMatch[1].replace(/,/g, ''));
                                    if (val >= 100 && val < 1000000000) {
                                        lineAmounts.push({
                                            value: val,
                                            str: amtMatch[1],
                                            index: amtMatch.index
                                        });
                                    }
                                }
                            }
                            
                            if (lineAmounts.length < 1) return; // Skip lines without amounts
                            linesWithAmounts++;
                            
                            // Determine transaction type from DR/CR indicator
                            // Strip DR/CR that appears right after an amount (balance indicator, not transaction type)
                            // e.g. "48,65,847.49 Cr" → balance indicator, NOT transaction credit
                            const lineForDRCR = cleanedLine.replace(/([\d,]+\.\d{2})\s*(Cr|Dr|CR|DR)\b/g, '$1');
                            const hasDR = /\bDR\b/i.test(lineForDRCR) || /\bDr\b/.test(lineForDRCR) || /debit/i.test(lineForDRCR);
                            const hasCR = /\bCR\b/i.test(lineForDRCR) || /\bCr\b/.test(lineForDRCR) || /credit/i.test(lineForDRCR);
                            
                            if (hasDR || hasCR) linesWithDRCR++;
                            
                            // Also use keywords as fallback
                            const hasCredKw = creditKeywords.some(kw => cleanedLine.toUpperCase().includes(kw.toUpperCase()));
                            const hasDebKw = debitKeywords.some(kw => cleanedLine.toUpperCase().includes(kw.toUpperCase()));
                            
                            let isCredit = false;
                            let isDebit = false;
                            let txnAmount = 0;
                            
                            // DR/CR indicator takes precedence
                            if (hasDR && hasCR) {
                                // Both DR and CR in same line - use whichever appears FIRST
                                const drIdx = cleanedLine.search(/\bDR\b/i);
                                const crIdx = cleanedLine.search(/\bCR\b/i);
                                if (drIdx >= 0 && (crIdx < 0 || drIdx < crIdx)) {
                                    isDebit = true;
                                } else {
                                    isCredit = true;
                                }
                            } else if (hasDR && !hasCR) {
                                isDebit = true;
                            } else if (hasCR && !hasDR) {
                                isCredit = true;
                            } else if (!hasDR && !hasCR) {
                                // Check for SBI-style "--amount" pattern (double dash = debit, empty credit column)
                                if (!isCredit && !isDebit && lineAmounts.length >= 2) {
                                    const sortedAmts = [...lineAmounts].sort((a, b) => a.index - b.index);
                                    const firstIdx = sortedAmts[0].index;
                                    if (firstIdx >= 2 && cleanedLine.substring(firstIdx - 2, firstIdx) === '--') {
                                        isDebit = true;
                                    }
                                }
                                // No DR/CR indicator - use keywords as fallback
                                if (!isCredit && !isDebit) {
                                    if (hasCredKw && !hasDebKw) {
                                        isCredit = true;
                                    } else if (hasDebKw) {
                                        isDebit = true;
                                    }
                                }
                            }
                            
                            // COLUMNAR FORMAT DETECTION: When 3+ amounts exist without DR/CR indicators
                            // Format is typically: Debit | Credit | Balance (or Withdrawal | Deposit | Balance)
                            // One of Debit/Credit will be 0.00 and the other has the actual amount
                            if (!isCredit && !isDebit && lineAmounts.length >= 3) {
                                // Sort amounts by position (left to right in the line)
                                const sortedAmts = [...lineAmounts].sort((a, b) => a.index - b.index);
                                const balance = sortedAmts[sortedAmts.length - 1].value; // Last is balance
                                
                                // Check for columnar format: (Debit, Credit, Balance) or (Withdrawal, Deposit, Balance)
                                // A zero or near-zero value indicates which column is empty
                                const col1 = sortedAmts[sortedAmts.length - 3]?.value || 0; // Debit column
                                const col2 = sortedAmts[sortedAmts.length - 2]?.value || 0; // Credit column
                                
                                const threshold = 0.01; // Values below this are considered "empty"
                                const col1Empty = col1 < threshold;
                                const col2Empty = col2 < threshold;
                                
                                if (col1Empty && !col2Empty) {
                                    // Credit column has value, debit is empty
                                    isCredit = true;
                                    txnAmount = col2;
                                    columnarDetections++;
                                } else if (!col1Empty && col2Empty) {
                                    // Debit column has value, credit is empty
                                    isDebit = true;
                                    txnAmount = col1;
                                    columnarDetections++;
                                } else if (!col1Empty && !col2Empty) {
                                    // Both have values - use the larger one (unusual case)
                                    if (col1 > col2) {
                                        isDebit = true;
                                        txnAmount = col1;
                                    } else {
                                        isCredit = true;
                                        txnAmount = col2;
                                    }
                                    columnarDetections++;
                                }
                            }
                            
                            // BALANCE-DIRECTION DETECTION: Use running balance to determine debit/credit
                            // This is the most reliable method for statements where column structure is lost (e.g. ICICI)
                            // Works when we have at least 2 amounts (transaction + balance) and a previous balance
                            if (!isCredit && !isDebit && previousBalance !== null && lineAmounts.length >= 2) {
                                // Compute preliminary txnAmount for balance check
                                let prelimAmt = lineAmounts.length <= 2 ? lineAmounts[0].value : lineAmounts[lineAmounts.length - 2].value;
                                const currentBal = lineAmounts[lineAmounts.length - 1].value;
                                const tolerance = Math.max(2.0, prelimAmt * 0.005); // 0.5% tolerance or ₹2

                                if (Math.abs(previousBalance - prelimAmt - currentBal) < tolerance) {
                                    // Balance decreased by this amount → debit
                                    isDebit = true;
                                    txnAmount = prelimAmt;
                                } else if (Math.abs(previousBalance + prelimAmt - currentBal) < tolerance) {
                                    // Balance increased by this amount → credit
                                    isCredit = true;
                                    txnAmount = prelimAmt;
                                }
                            }

                            // Skip if we can't determine transaction type
                            if (!isCredit && !isDebit) {
                                // Still update previousBalance so next line can use it
                                if (lineAmounts.length >= 1) {
                                    previousBalance = lineAmounts[lineAmounts.length - 1].value;
                                }
                                return;
                            }

                            if (isCredit) creditLines++;
                            if (isDebit) debitLines++;

                            // Determine transaction amount if not already set by columnar/balance detection
                            if (txnAmount === 0) {
                                // For lines with explicit DR/CR indicator, find the amount right after the indicator
                                const drcrMatch = cleanedLine.match(/\b(DR|CR)\s+([\d,]+\.\d{2})/i);
                                if (drcrMatch) {
                                    txnAmount = parseFloat(drcrMatch[2].replace(/,/g, ''));
                                }
                                // Fallback: use positional logic
                                if (txnAmount === 0) {
                                    if (lineAmounts.length === 1) {
                                        txnAmount = lineAmounts[0].value;
                                    } else if (lineAmounts.length === 2) {
                                        // First is transaction, second is balance
                                        txnAmount = lineAmounts[0].value;
                                    } else {
                                        // Multiple amounts - second-to-last is transaction, last is balance
                                        txnAmount = lineAmounts[lineAmounts.length - 2].value;
                                    }
                                }
                            }

                            // BALANCE-DIRECTION CORRECTION: If keyword-based classification disagrees
                            // with balance direction, trust the balance (keywords are ambiguous for NEFT/IMPS/UPI etc.)
                            if (previousBalance !== null && txnAmount > 0 && lineAmounts.length >= 2 && !hasDR && !hasCR) {
                                const currentBal = lineAmounts[lineAmounts.length - 1].value;
                                const tolerance = Math.max(2.0, txnAmount * 0.005);

                                const balSaysDebit = Math.abs(previousBalance - txnAmount - currentBal) < tolerance;
                                const balSaysCredit = Math.abs(previousBalance + txnAmount - currentBal) < tolerance;

                                if (balSaysDebit && isCredit) {
                                    isCredit = false;
                                    isDebit = true;
                                    creditLines--;
                                    debitLines++;
                                } else if (balSaysCredit && isDebit) {
                                    isDebit = false;
                                    isCredit = true;
                                    debitLines--;
                                    creditLines++;
                                }
                            }

                            // Track daily balance (last amount) and update running balance
                            const closingBalance = lineAmounts[lineAmounts.length - 1].value;
                            previousBalance = closingBalance;
                            const dateKey = `${txnDate.day}-${txnDate.month}-${txnDate.year}`;
                            dailyBalances[dateKey] = {
                                balance: closingBalance,
                                monthKey: txnDate.monthKey
                            };
                            
                            // Create unique key to avoid duplicates - include description snippet to distinguish
                            // different transactions with same date and amount (e.g. multiple UPI reversals)
                            // Strip leading dates/timestamps/serial numbers from particulars to show meaningful description
                            let particulars = cleanedLine.replace(/\s+/g, ' ').trim();
                            // Remove leading date patterns (dd/mm/yyyy, dd/Mon/yyyy, dd-mm-yy), timestamps, serial numbers
                            particulars = particulars
                                .replace(/^\d{1,4}\s+/, '')  // Leading serial number
                                .replace(/^[A-Z]\d{1,6}\s+/, '')  // ICICI S1234 format
                                .replace(/\d{2}[\/\-](\w{3}|\d{2})[\/\-]\d{2,4}\s*/g, '')  // All date patterns
                                .replace(/\d{2}:\d{2}:\d{2}\s*(AM|PM)?\s*/gi, '')  // Timestamps
                                .replace(/^\s*/, '')
                                .substring(0, 100).trim();
                            const refMatch = cleanedLine.match(/(?:RVSL|NEFT|IMPS|RTGS|UPI|INF|CLG|ACH|CMS|MMT|CAM)[\/\w]*\d{6,}/i);
                            const txnRef = refMatch ? refMatch[0].substring(0, 30) : particulars.substring(0, 60);
                            const key = `${txnDate.dateStr}-${txnAmount}-${isCredit ? 'CR' : 'DR'}-${txnRef}`;
                            
                            if (txnAmount > 0) {
                                if (isCredit && !seenCredits.has(key)) {
                                    seenCredits.add(key);
                                    
                                    if (!monthCreditsTotal[txnDate.monthKey]) monthCreditsTotal[txnDate.monthKey] = 0;
                                    monthCreditsTotal[txnDate.monthKey] += txnAmount;
                                    
                                    const isInterGroup = isInterGroupTransaction(particulars);
                                    if (isInterGroup) {
                                        if (!monthlyInterGroupCredits[txnDate.monthKey]) monthlyInterGroupCredits[txnDate.monthKey] = 0;
                                        monthlyInterGroupCredits[txnDate.monthKey] += txnAmount;
                                    }
                                    
                                    allCredits.push({
                                        date: txnDate.dateStr,
                                        particulars: particulars.substring(0, 80),
                                        amount: txnAmount,
                                        monthKey: txnDate.monthKey,
                                        isInterGroup: isInterGroup
                                    });
                                } else if (isDebit && !seenDebits.has(key)) {
                                    seenDebits.add(key);
                                    
                                    if (!monthDebitsTotal[txnDate.monthKey]) monthDebitsTotal[txnDate.monthKey] = 0;
                                    monthDebitsTotal[txnDate.monthKey] += txnAmount;
                                    
                                    const isInterGroupDebit = isInterGroupTransaction(particulars);
                                    if (isInterGroupDebit) {
                                        if (!monthlyInterGroupDebits[txnDate.monthKey]) monthlyInterGroupDebits[txnDate.monthKey] = 0;
                                        monthlyInterGroupDebits[txnDate.monthKey] += txnAmount;
                                    }
                                }
                            }
                        });
                        
                        // Debug: Log classification summary to browser console
                        console.log(`[Banking Debug] Account: ${account.accountName}`);
                        console.log(`  Merged lines: ${mergedLineCount}, Lines with dates: ${linesWithDates}`);
                        console.log(`  Credits: ${creditLines}, Debits: ${debitLines}, DR/CR indicators: ${linesWithDRCR}`);
                        console.log(`  Total credits: ₹${Object.values(monthCreditsTotal).reduce((s,v)=>s+v,0).toLocaleString('en-IN')}`);
                        console.log(`  Total debits: ₹${Object.values(monthDebitsTotal).reduce((s,v)=>s+v,0).toLocaleString('en-IN')}`);
                        console.log(`  Debits by month:`, monthDebitsTotal);
                        console.log(`  Top 10 debits:`, [...seenDebits].slice(0,10));

                        // Calculate monthly average balances from daily balances
                        const monthlyAvgBalances = {};
                        Object.keys(dailyBalances).forEach(dateKey => {
                            const entry = dailyBalances[dateKey];
                            const monthKey = entry.monthKey;
                            if (!monthlyBalanceSums[monthKey]) {
                                monthlyBalanceSums[monthKey] = { sum: 0, count: 0 };
                            }
                            monthlyBalanceSums[monthKey].sum += entry.balance;
                            monthlyBalanceSums[monthKey].count += 1;
                        });
                        
                        // Calculate averages
                        Object.keys(monthlyBalanceSums).forEach(monthKey => {
                            const data = monthlyBalanceSums[monthKey];
                            monthlyAvgBalances[monthKey] = data.count > 0 ? data.sum / data.count : 0;
                        });
                        
                        // Check for bounces/returns
                        const textLower = text.toLowerCase();
                        const bounceKeywords = ['bounce', 'return', 'dishonour', 'insufficient', 'unpaid', 'chq ret', 'chq rtn'];
                        bounceKeywords.forEach(kw => {
                            const regex = new RegExp(kw, 'gi');
                            const matches = text.match(regex) || [];
                            if (kw.includes('chq') || kw === 'return') {
                                outwardReturns += matches.length;
                            } else {
                                inwardReturns += matches.length;
                            }
                        });
                        
                        // Check for EMI bounces
                        const emiBouncePattern = /ach.*?(bounce|return|dishonour|reject)/gi;
                        const emiBounceMatches = text.match(emiBouncePattern) || [];
                        emiBounces = emiBounceMatches.length;
                        
                        // Sort credits by amount for top 10
                        allCredits.sort((a, b) => b.amount - a.amount);
                        const top10Credits = allCredits.slice(0, 10);
                        
                        // Combine all months from credits, debits, and balances to find available data months
                        const allMonthKeys = new Set([
                            ...Object.keys(monthCreditsTotal),
                            ...Object.keys(monthDebitsTotal),
                            ...Object.keys(monthlyAvgBalances)
                        ]);
                        
                        // Sort all available months chronologically (newest to oldest for display)
                        const allSortedMonths = Array.from(allMonthKeys).sort((a, b) => {
                            const [mA, yA] = a.split('-');
                            const [mB, yB] = b.split('-');
                            return (parseInt(yB) * 12 + parseInt(mB)) - (parseInt(yA) * 12 + parseInt(mA));
                        });
                        
                        // Generate last 12 months from the most recent data month (not current date)
                        // This ensures we show the actual data period
                        let sortedMonths = [];
                        if (allSortedMonths.length > 0) {
                            // Use the most recent month in the data as the starting point
                            const [latestMonth, latestYear] = allSortedMonths[0].split('-').map(Number);
                            for (let i = 0; i < 12; i++) {
                                const d = new Date(latestYear, latestMonth - 1 - i, 1);
                                const m = String(d.getMonth() + 1).padStart(2, '0');
                                const y = d.getFullYear();
                                sortedMonths.push(m + '-' + y);
                            }
                        } else {
                            // Fallback to current date if no data
                            const now = new Date();
                            for (let i = 0; i < 12; i++) {
                                const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                                const m = String(d.getMonth() + 1).padStart(2, '0');
                                const y = d.getFullYear();
                                sortedMonths.push(m + '-' + y);
                            }
                        }
                        
                        accountAnalysis[acNo] = {
                            accountNo: acNo,
                            accountName: account.accountName,
                            monthlyCredits: monthCreditsTotal,
                            monthlyDebits: monthDebitsTotal,
                            monthlyInterGroupCredits: monthlyInterGroupCredits,
                            monthlyInterGroupDebits: monthlyInterGroupDebits,
                            monthlyAvgBalances: monthlyAvgBalances,
                            sortedMonths: sortedMonths,
                            top10Credits: top10Credits,
                            inwardReturns: inwardReturns,
                            outwardReturns: outwardReturns,
                            emiBounces: emiBounces,
                            // Debug info
                            _debug: {
                                textLength: text.length,
                                rawLines: rawLineCount,
                                mergedLines: mergedLineCount,
                                datesFound: txnDates.length,
                                allMonthsFound: Array.from(allMonthKeys),
                                linesWithDates: linesWithDates,
                                linesWithAmounts: linesWithAmounts,
                                linesWithDRCR: linesWithDRCR,
                                columnarDetections: columnarDetections,
                                creditLines: creditLines,
                                debitLines: debitLines,
                                sampleLines: sampleLines
                            }
                        };
                    });
                    
                    const accountsList = Object.values(accountAnalysis);
                    %>
                    
                    <% if (accountsList.length === 0) { %>
                        <div class="placeholder-content">
                            <div class="icon">🏦</div>
                            <p>No banking documents uploaded yet.</p>
                        </div>
                    <% } else { %>
                        <% accountsList.forEach((account, idx) => { %>
                            <div style="margin-bottom: 40px; padding: 20px; background: #f8f9fa; border-radius: 8px; border-left: 4px solid #3498db;">
                                <!-- Account Header -->
                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #2c3e50; margin: 0 0 10px 0; padding-bottom: 8px; border-bottom: 2px solid #3498db;">
                                        Banking Analysis for A/C No: <span style="color: #3498db;"><%= account.accountNo %></span>
                                    </h4>
                                    <p style="margin: 0; color: #666;">Account Name: <strong><%= account.accountName %></strong></p>
                                    <!-- Debug: Show detected months -->
                                    <p style="margin: 5px 0 0 0; font-size: 0.8em; color: #888;">
                                        Text: <%= account._debug?.textLength || 0 %> chars | 
                                        Raw lines: <%= account._debug?.rawLines || 0 %> → Merged: <%= account._debug?.mergedLines || 0 %> |
                                        Dates: <%= account._debug?.datesFound || 0 %> | 
                                        Lines with dates: <%= account._debug?.linesWithDates || 0 %> |
                                        Lines with amounts: <%= account._debug?.linesWithAmounts || 0 %> |
                                        Lines with DR/CR: <%= account._debug?.linesWithDRCR || 0 %> |
                                        Columnar: <%= account._debug?.columnarDetections || 0 %> |
                                        Credit lines: <%= account._debug?.creditLines || 0 %> |
                                        Debit lines: <%= account._debug?.debitLines || 0 %>
                                    </p>
                                    <p style="margin: 5px 0 0 0; font-size: 0.8em; color: #888;">
                                        Credits in: <%= Object.keys(account.monthlyCredits).join(', ') || 'None' %> | 
                                        Debits in: <%= Object.keys(account.monthlyDebits).join(', ') || 'None' %>
                                    </p>
                                    <% if (account._debug?.sampleLines?.length > 0) { %>
                                    <div style="margin-top: 8px; padding: 8px; background: #fff3cd; border-radius: 4px; font-size: 0.75em; font-family: monospace;">
                                        <strong>Sample lines:</strong><br>
                                        <% account._debug.sampleLines.forEach((line, i) => { %>
                                            <%= i+1 %>: <%= line %><br>
                                        <% }); %>
                                    </div>
                                    <% } %>
                                </div>
                                
                                <!-- Credit Analysis -->
                                <div style="margin-bottom: 25px;">
                                    <h5 style="background: #f1c40f; color: #000; padding: 8px 12px; margin: 0 0 10px 0; border-radius: 4px;">Credit Analysis</h5>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9em;">
                                        <thead>
                                            <tr style="background: #fff;">
                                                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Months</th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Amount in Rs.</th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Inter / Group Deposits</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% 
                                            let totalCredits = 0;
                                            let totalInterGroupCredits = 0;
                                            account.sortedMonths.forEach(monthKey => { 
                                                const [m, y] = monthKey.split('-');
                                                const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                                const monthLabel = monthNames[parseInt(m)] + '-' + y.slice(-2);
                                                const creditAmt = account.monthlyCredits[monthKey] || 0;
                                                const interGroupAmt = account.monthlyInterGroupCredits[monthKey] || 0;
                                                totalCredits += creditAmt;
                                                totalInterGroupCredits += interGroupAmt;
                                            %>
                                                <tr>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;"><%= monthLabel %></td>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;">₹ <%= creditAmt.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;<%= interGroupAmt > 0 ? ' color: #e74c3c; font-weight: bold;' : ' color: #888;' %>"><%= interGroupAmt > 0 ? '₹ ' + interGroupAmt.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '-' %></td>
                                                </tr>
                                            <% }); %>
                                            <tr style="background: #e8e8e8; font-weight: bold;">
                                                <td style="padding: 8px 10px; text-align: left; border: 1px solid #ddd;">Total</td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;">₹ <%= totalCredits.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;<%= totalInterGroupCredits > 0 ? ' color: #e74c3c;' : '' %>"><%= totalInterGroupCredits > 0 ? '₹ ' + totalInterGroupCredits.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '-' %></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <!-- Debits Analysis -->
                                <div style="margin-bottom: 25px;">
                                    <h5 style="background: #f1c40f; color: #000; padding: 8px 12px; margin: 0 0 10px 0; border-radius: 4px;">Debits Analysis</h5>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9em;">
                                        <thead>
                                            <tr style="background: #fff;">
                                                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Months</th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Amount in Rs.</th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Inter / Group Payments</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% 
                                            let totalDebits = 0;
                                            let totalInterGroupDebits = 0;
                                            account.sortedMonths.forEach(monthKey => { 
                                                const [m, y] = monthKey.split('-');
                                                const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                                const monthLabel = monthNames[parseInt(m)] + '-' + y.slice(-2);
                                                const debitAmt = account.monthlyDebits[monthKey] || 0;
                                                const interGroupDebitAmt = account.monthlyInterGroupDebits[monthKey] || 0;
                                                totalDebits += debitAmt;
                                                totalInterGroupDebits += interGroupDebitAmt;
                                            %>
                                                <tr>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;"><%= monthLabel %></td>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;">₹ <%= debitAmt.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;<%= interGroupDebitAmt > 0 ? ' color: #e74c3c; font-weight: bold;' : ' color: #888;' %>"><%= interGroupDebitAmt > 0 ? '₹ ' + interGroupDebitAmt.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '-' %></td>
                                                </tr>
                                            <% }); %>
                                            <tr style="background: #e8e8e8; font-weight: bold;">
                                                <td style="padding: 8px 10px; text-align: left; border: 1px solid #ddd;">Total</td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;">₹ <%= totalDebits.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;<%= totalInterGroupDebits > 0 ? ' color: #e74c3c;' : '' %>"><%= totalInterGroupDebits > 0 ? '₹ ' + totalInterGroupDebits.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '-' %></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <!-- Top 10 Bulk Credits -->
                                <div style="margin-bottom: 25px;">
                                    <h5 style="background: #f1c40f; color: #000; padding: 8px 12px; margin: 0 0 10px 0; border-radius: 4px;">Top 10 Bulk Credits</h5>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9em;">
                                        <thead>
                                            <tr style="background: #fff;">
                                                <th style="padding: 10px; text-align: left; border: 1px solid #ddd; width: 120px;">Date</th>
                                                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Particulars</th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd; width: 150px;">Amt in Rs.</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% account.top10Credits.forEach(credit => { %>
                                                <tr<%= credit.isInterGroup ? ' style="background: #fff5f5;"' : '' %>>
                                                    <td style="padding: 8px 10px; border: 1px solid #ddd;"><%= credit.date %></td>
                                                    <td style="padding: 8px 10px; border: 1px solid #ddd;"><%= credit.particulars %><%= credit.isInterGroup ? ' <span style="color: #e74c3c; font-weight: bold; font-size: 0.8em;">[INTER-GROUP]</span>' : '' %></td>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;<%= credit.isInterGroup ? ' color: #e74c3c; font-weight: bold;' : '' %>">₹ <%= credit.amount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                                </tr>
                                            <% }); %>
                                            <% if (account.top10Credits.length === 0) { %>
                                                <tr>
                                                    <td colspan="3" style="padding: 8px 10px; text-align: center; border: 1px solid #ddd; color: #888;">No bulk credits found</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <!-- Average Banking Analysis -->
                                <div style="margin-bottom: 25px;">
                                    <h5 style="background: #f1c40f; color: #000; padding: 8px 12px; margin: 0 0 10px 0; border-radius: 4px;">Average Banking Analysis</h5>
                                    <p style="font-size: 0.85em; color: #666; margin: 0 0 10px 0;">Average of day closing balances per month</p>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9em;">
                                        <thead>
                                            <tr style="background: #fff;">
                                                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Months</th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Avg. Daily Balance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% 
                                            let totalAvgBalance = 0;
                                            let avgMonthCount = 0;
                                            account.sortedMonths.forEach(monthKey => { 
                                                const [m, y] = monthKey.split('-');
                                                const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                                                const monthLabel = monthNames[parseInt(m)] + '-' + y.slice(-2);
                                                const avgBalance = account.monthlyAvgBalances[monthKey] || 0;
                                                if (avgBalance > 0) {
                                                    totalAvgBalance += avgBalance;
                                                    avgMonthCount++;
                                                }
                                            %>
                                                <tr>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;"><%= monthLabel %></td>
                                                    <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;"><%= avgBalance > 0 ? '₹ ' + avgBalance.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '-' %></td>
                                                </tr>
                                            <% }); %>
                                            <tr style="background: #e8e8e8; font-weight: bold;">
                                                <td style="padding: 8px 10px; text-align: left; border: 1px solid #ddd;">Overall Average</td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;">₹ <%= avgMonthCount > 0 ? (totalAvgBalance / avgMonthCount).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0.00' %></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <!-- Adverse Observations -->
                                <div style="margin-bottom: 15px;">
                                    <h5 style="background: #f1c40f; color: #000; padding: 8px 12px; margin: 0 0 10px 0; border-radius: 4px;">Adverse Observations</h5>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9em;">
                                        <thead>
                                            <tr style="background: #fff;">
                                                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;"></th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Inward</th>
                                                <th style="padding: 10px; text-align: right; border: 1px solid #ddd;">Outward</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="padding: 8px 10px; border: 1px solid #ddd;">Cheque Returns</td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;"><%= account.inwardReturns %></td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;"><%= account.outwardReturns %></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 10px; border: 1px solid #ddd;">EMI Bounces</td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;"><%= account.emiBounces %></td>
                                                <td style="padding: 8px 10px; text-align: right; border: 1px solid #ddd;">0</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <div id="turnoverPanel" class="analysis-panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <h3 style="margin: 0; padding-bottom: 10px; border-bottom: 2px solid #3498db;">Turnover Analysis</h3>
                        <button onclick="refreshTurnoverData()" id="refreshTurnoverBtn" style="background: #3498db; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 6px;">
                            <span style="font-size: 1.1em;">&#8635;</span> Refresh Data
                        </button>
                    </div>

                    <%
                    // Get all GST documents
                    let gstDocuments = (proposal.documents || []).filter(doc =>
                        doc.category === 'turnover' &&
                        (doc.extractedText && (doc.extractedText.includes('GSTR-3B') || doc.extractedText.includes('Form GSTR-3B')))
                    );
                    
                    // Remove duplicate GST documents by originalName
                    const gstSeenNames = new Set();
                    gstDocuments = gstDocuments.filter(doc => {
                        if (gstSeenNames.has(doc.originalName)) {
                            return false; // Skip duplicate
                        }
                        gstSeenNames.add(doc.originalName);
                        return true;
                    });

                    // Group by GSTIN
                    const gstDataByGstin = {};

                    gstDocuments.forEach(doc => {
                        const text = doc.extractedText || '';

                        // Extract GSTIN
                        let gstin = 'Unknown';
                        const gstinMatch = text.match(/GSTIN of the supplier\s+([A-Z0-9]{15})/);
                        if (gstinMatch) {
                            gstin = gstinMatch[1];
                        } else {
                            const filenameMatch = doc.originalName.match(/GSTR3B_([A-Z0-9]{15})_/);
                            if (filenameMatch) gstin = filenameMatch[1];
                        }

                        // Extract Trade Name and Legal Name
                        let tradeName = '';
                        let legalName = '';
                        const tradeMatch = text.match(/Trade name,?\s*(?:if any)?\s*([A-Z0-9\s]+?)(?:\n|2\(c\))/i);
                        const legalMatch = text.match(/Legal name of the registered person\s+([A-Z0-9\s]+?)(?:\n|2\(b\))/i);
                        if (tradeMatch) tradeName = tradeMatch[1].trim();
                        if (legalMatch) legalName = legalMatch[1].trim();

                        // Extract Period and Year
                        let period = '';
                        let year = '';
                        const periodMatch = text.match(/Period\s+([A-Za-z]+)/);
                        const yearMatch = text.match(/Year\s+(\d{4}-\d{2})/);
                        if (periodMatch) period = periodMatch[1];
                        if (yearMatch) year = yearMatch[1];

                        // Extract Outward Supplies data from Section 3.1
                        // Pattern: (a) Outward taxable supplies ... followed by numbers
                        let taxableValue = 0;
                        let integratedTax = 0;
                        let centralTax = 0;
                        let stateTax = 0;
                        let cess = 0;

                        // Match outward taxable supplies row (a) - support negative values for sales returns
                        const outwardMatch = text.match(/\(a\)\s*Outward taxable supplies[^)]+\)\s*(-?[\d,.]+)\s+(-?[\d,.]+)\s+(-?[\d,.]+)\s+(-?[\d,.]+)\s+(-?[\d,.]+)/);
                        if (outwardMatch) {
                            taxableValue = parseFloat(outwardMatch[1].replace(/,/g, '')) || 0;
                            integratedTax = parseFloat(outwardMatch[2].replace(/,/g, '')) || 0;
                            centralTax = parseFloat(outwardMatch[3].replace(/,/g, '')) || 0;
                            stateTax = parseFloat(outwardMatch[4].replace(/,/g, '')) || 0;
                            cess = parseFloat(outwardMatch[5].replace(/,/g, '')) || 0;
                        }

                        // Extract zero rated outward supplies from section 3.1(b) - support negative values
                        let zeroRatedValue = 0;
                        const zeroRatedMatch = text.match(/\(b\)\s*Outward taxable supplies\s*\(zero rated\)\s*(-?[\d,.]+)/i);
                        if (zeroRatedMatch) {
                            zeroRatedValue = parseFloat(zeroRatedMatch[1].replace(/,/g, '')) || 0;
                        }

                        // Extract exempted outward supplies from section 3.1(c) - nil rated, exempted
                        let exemptedValue = 0;
                        const exemptedMatch = text.match(/\(c\s*\)\s*Other outward supplies\s*\(nil rated,?\s*exempted\)\s*(-?[\d,.]+)/i);
                        if (exemptedMatch) {
                            exemptedValue = parseFloat(exemptedMatch[1].replace(/,/g, '')) || 0;
                        }

                        // Extract e-commerce supplies from section 3.1.1(ii)
                        // "(ii) Taxable supplies made by registered person through electronic commerce operator"
                        // The Total taxable value is the first number after the description
                        let ecommerceSupplies = 0;
                        const ecomMatch = text.match(/\(ii\)\s*Taxable supplies made by registered person through electronic commerce[^\]]*\]\s*(-?[\d,.]+)/i);
                        if (ecomMatch) {
                            ecommerceSupplies = parseFloat(ecomMatch[1].replace(/,/g, '')) || 0;
                        }

                        if (!gstDataByGstin[gstin]) {
                            gstDataByGstin[gstin] = {
                                tradeName: tradeName,
                                legalName: legalName,
                                months: []
                            };
                        }

                        // Update names if found
                        if (tradeName && !gstDataByGstin[gstin].tradeName) {
                            gstDataByGstin[gstin].tradeName = tradeName;
                        }
                        if (legalName && !gstDataByGstin[gstin].legalName) {
                            gstDataByGstin[gstin].legalName = legalName;
                        }

                        // If same amount appears in both Exempted and Ecommerce Supplies,
                        // count only once (in Ecommerce for Hospitality sector)
                        let finalExempted = exemptedValue;
                        let finalEcommerce = ecommerceSupplies;
                        if (exemptedValue > 0 && ecommerceSupplies > 0 && exemptedValue === ecommerceSupplies) {
                            finalExempted = 0; // Count only in Ecommerce column
                        }

                        // Check if this period+year already exists for this GSTIN (avoid duplicates)
                        const existingMonthIndex = gstDataByGstin[gstin].months.findIndex(
                            m => m.period === period && m.year === year
                        );

                        const monthData = {
                            period: period,
                            year: year,
                            taxableValue: taxableValue,
                            zeroRatedValue: zeroRatedValue,
                            exemptedValue: finalExempted,
                            ecommerceSupplies: finalEcommerce,
                            totalOutward: taxableValue + zeroRatedValue + finalExempted + finalEcommerce,
                            integratedTax: integratedTax,
                            centralTax: centralTax,
                            stateTax: stateTax,
                            cess: cess,
                            totalTax: integratedTax + centralTax + stateTax + cess
                        };

                        if (existingMonthIndex === -1) {
                            // No duplicate - add new month
                            gstDataByGstin[gstin].months.push(monthData);
                        } else {
                            // Duplicate found - keep the one with higher totalOutward value
                            const existing = gstDataByGstin[gstin].months[existingMonthIndex];
                            if (monthData.totalOutward > existing.totalOutward) {
                                gstDataByGstin[gstin].months[existingMonthIndex] = monthData;
                            }
                        }
                    });

                    // Check if this is Hospitality sector
                    const isHospitality = proposal.industry === 'Hospitality';

                    // Sort months for each GSTIN in chronological order (FY: April to March)
                    const monthOrder = ['April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December', 'January', 'February', 'March'];

                    // Helper function to get sort key for chronological ordering
                    // For FY 2024-25: April-Dec are in 2024, Jan-Mar are in 2025
                    function getSortKey(month) {
                        const fyMatch = month.year.match(/(\d{4})-(\d{2})/);
                        if (!fyMatch) return 0;

                        const fyStartYear = parseInt(fyMatch[1]); // e.g., 2024 from "2024-25"
                        const monthIdx = monthOrder.indexOf(month.period);

                        // April-December (index 0-8) belong to fyStartYear
                        // January-March (index 9-11) belong to fyStartYear + 1
                        let calendarYear = fyStartYear;
                        if (monthIdx >= 9) { // January, February, March
                            calendarYear = fyStartYear + 1;
                        }

                        // Convert month name to number (April=4, May=5, ..., March=3)
                        const calendarMonthMap = {
                            'April': 4, 'May': 5, 'June': 6, 'July': 7,
                            'August': 8, 'September': 9, 'October': 10, 'November': 11,
                            'December': 12, 'January': 1, 'February': 2, 'March': 3
                        };
                        const calendarMonth = calendarMonthMap[month.period] || 1;

                        // Return sortable key: YYYYMM
                        return calendarYear * 100 + calendarMonth;
                    }

                    Object.keys(gstDataByGstin).forEach(gstin => {
                        gstDataByGstin[gstin].months.sort((a, b) => {
                            return getSortKey(a) - getSortKey(b);
                        });
                    });

                    const gstinList = Object.keys(gstDataByGstin);

                    // Check if any data has values (to detect if extraction was truncated)
                    let hasAnyValues = false;
                    gstinList.forEach(gstin => {
                        gstDataByGstin[gstin].months.forEach(m => {
                            if (m.taxableValue > 0 || m.totalTax > 0) hasAnyValues = true;
                        });
                    });
                    %>

                    <%
                    // Calculate GST turnover for FY2025-26 (latest year - to be annualized)
                    // For FY2025-26, only use April 2025 onwards and count UNIQUE months
                    const gstTurnoverByFY = {};
                    const uniqueMonthsByFY = {}; // Track unique months per FY

                    gstinList.forEach(gstin => {
                        const gstData = gstDataByGstin[gstin];
                        gstData.months.forEach(m => {
                            if (!gstTurnoverByFY[m.year]) {
                                gstTurnoverByFY[m.year] = 0;
                                uniqueMonthsByFY[m.year] = new Set();
                            }
                            gstTurnoverByFY[m.year] += m.totalOutward;
                            // Track unique months using period name (April, May, etc.)
                            uniqueMonthsByFY[m.year].add(m.period);
                        });
                    });

                    // Get FYs from GST data and find the latest one
                    const gstFYs = Object.keys(gstTurnoverByFY).sort((a, b) => {
                        const yearA = parseInt(a.split('-')[0]);
                        const yearB = parseInt(b.split('-')[0]);
                        return yearA - yearB;
                    });
                    const latestGstFY = gstFYs[gstFYs.length - 1]; // e.g., "2025-26"

                    // Calculate annualized turnover for latest FY from GST
                    // Use unique month count for proper annualization
                    let projectedTurnover = 0;
                    let projectedMonths = 0;
                    if (latestGstFY && uniqueMonthsByFY[latestGstFY]) {
                        projectedMonths = uniqueMonthsByFY[latestGstFY].size; // Count of unique months
                        projectedTurnover = (gstTurnoverByFY[latestGstFY] / projectedMonths) * 12;
                    }

                    // P&L Sales figures - auto-extract from ITR documents
                    let extractedSales2324 = 0;
                    let extractedSales2425 = 0;
                    let extractedSales2223 = 0;

                    // Extract sales from financial documents
                    const financialDocs = proposal.documents ? proposal.documents.filter(d => d.category === 'financials') : [];
                    financialDocs.forEach(doc => {
                        const classification = (doc.classification || '').toLowerCase();
                        const text = doc.extractedText || '';

                        // Determine FY from classification
                        let docFY = null;
                        if (classification.includes('fy2024-25') || classification.includes('fy 2024-25') || classification.includes('2024-25')) docFY = '2024-25';
                        else if (classification.includes('fy2023-24') || classification.includes('fy 2023-24') || classification.includes('2023-24')) docFY = '2023-24';
                        else if (classification.includes('fy2022-23') || classification.includes('fy 2022-23') || classification.includes('2022-23')) docFY = '2022-23';

                        // Only process business entity ITRs (check if classification contains applicant name or known business names)
                        const applicantName = (proposal.applicantName || '').toLowerCase();
                        const isBusinessITR = applicantName && classification.includes(applicantName.split(' ')[0]) || 
                                              classification.includes('private limited') || 
                                              classification.includes('pvt ltd') ||
                                              classification.includes('llp') ||
                                              classification.includes('pragati') || 
                                              classification.includes('pragathi');
                        
                        if (docFY && isBusinessITR) {
                            let salesAmount = 0;
                            let prevYearSalesAmount = 0;
                            
                            // Pattern 1: Trading Account format - "SALES \n7,69,93,805" or "BY SALES A/C \n12 \n7,63,04,012"
                            const salesMatch = text.match(/(?:BY\s+)?SALES(?:\s+A\/C)?\s*(?:\n?\d+\s*\n)?\s*([\d,]+(?:\.\d+)?)/i);
                            if (salesMatch) {
                                salesAmount = parseFloat(salesMatch[1].replace(/,/g, ''));
                            }
                            
                            // Pattern 2: P&L format - "Revenue from Operations 15 40,017,881.84 33,238,881.55" (current year, previous year)
                            if (!salesAmount) {
                                const revenueMatch = text.match(/Revenue\s+from\s+Operations\s*(?:\d+\s*)?\s*([\d,]+(?:\.\d+)?)\s+([\d,]+(?:\.\d+)?)?/i);
                                if (revenueMatch) {
                                    salesAmount = parseFloat(revenueMatch[1].replace(/,/g, ''));
                                    if (revenueMatch[2]) {
                                        prevYearSalesAmount = parseFloat(revenueMatch[2].replace(/,/g, ''));
                                    }
                                }
                            }
                            
                            // Pattern 3: Total Income or Gross Turnover
                            if (!salesAmount) {
                                const turnoverMatch = text.match(/(?:Gross\s+)?(?:Turnover|Total\s+Income)\s*[:\s]*\s*([\d,]+(?:\.\d+)?)/i);
                                if (turnoverMatch) {
                                    salesAmount = parseFloat(turnoverMatch[1].replace(/,/g, ''));
                                }
                            }
                            
                            // Current year extraction
                            if (salesAmount > 0) {
                                if (docFY === '2024-25' && salesAmount > extractedSales2425) extractedSales2425 = salesAmount;
                                else if (docFY === '2023-24' && salesAmount > extractedSales2324) extractedSales2324 = salesAmount;
                                else if (docFY === '2022-23' && salesAmount > extractedSales2223) extractedSales2223 = salesAmount;
                            }
                            
                            // Previous year extraction from same document (P&L often has comparative columns)
                            if (prevYearSalesAmount > 0) {
                                if (docFY === '2024-25' && prevYearSalesAmount > extractedSales2324) extractedSales2324 = prevYearSalesAmount;
