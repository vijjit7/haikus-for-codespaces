                    </div>
                </div>

                <div id="turnoverPanel" class="analysis-panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <h3 style="margin: 0; padding-bottom: 10px; border-bottom: 2px solid #3498db;">Turnover Analysis</h3>
                        <button onclick="refreshTurnoverData()" id="refreshTurnoverBtn" style="background: #3498db; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 6px;">
                            <span style="font-size: 1.1em;">&#8635;</span> Refresh Data
                        </button>
                    </div>

                    <%
                    // Get all GST documents
                    const gstDocuments = (proposal.documents || []).filter(doc =>
                        doc.category === 'turnover' &&
                        (doc.extractedText && (doc.extractedText.includes('GSTR-3B') || doc.extractedText.includes('Form GSTR-3B')))
                    );

                    // Group by GSTIN
                    const gstDataByGstin = {};

                    gstDocuments.forEach(doc => {
                        const text = doc.extractedText || '';

                        // Extract GSTIN
                        let gstin = 'Unknown';
                        const gstinMatch = text.match(/GSTIN of the supplier\s+([A-Z0-9]{15})/);
                        if (gstinMatch) {
                            gstin = gstinMatch[1];
                        } else {
                            const filenameMatch = doc.originalName.match(/GSTR3B_([A-Z0-9]{15})_/);
                            if (filenameMatch) gstin = filenameMatch[1];
                        }

                        // Extract Trade Name and Legal Name
                        let tradeName = '';
                        let legalName = '';
                        const tradeMatch = text.match(/Trade name,?\s*(?:if any)?\s*([A-Z0-9\s]+?)(?:\n|2\(c\))/i);
                        const legalMatch = text.match(/Legal name of the registered person\s+([A-Z0-9\s]+?)(?:\n|2\(b\))/i);
                        if (tradeMatch) tradeName = tradeMatch[1].trim();
                        if (legalMatch) legalName = legalMatch[1].trim();

                        // Extract Period and Year
                        let period = '';
                        let year = '';
                        const periodMatch = text.match(/Period\s+([A-Za-z]+)/);
                        const yearMatch = text.match(/Year\s+(\d{4}-\d{2})/);
                        if (periodMatch) period = periodMatch[1];
                        if (yearMatch) year = yearMatch[1];

                        // Extract Outward Supplies data from Section 3.1
                        // Pattern: (a) Outward taxable supplies ... followed by numbers
                        let taxableValue = 0;
                        let integratedTax = 0;
                        let centralTax = 0;
                        let stateTax = 0;
                        let cess = 0;

                        // Match outward taxable supplies row (a)
                        const outwardMatch = text.match(/\(a\)\s*Outward taxable supplies[^)]+\)\s*([\d,.]+)\s+([\d,.]+)\s+([\d,.]+)\s+([\d,.]+)\s+([\d,.]+)/);
                        if (outwardMatch) {
                            taxableValue = parseFloat(outwardMatch[1].replace(/,/g, '')) || 0;
                            integratedTax = parseFloat(outwardMatch[2].replace(/,/g, '')) || 0;
                            centralTax = parseFloat(outwardMatch[3].replace(/,/g, '')) || 0;
                            stateTax = parseFloat(outwardMatch[4].replace(/,/g, '')) || 0;
                            cess = parseFloat(outwardMatch[5].replace(/,/g, '')) || 0;
                        }

                        // Extract zero rated outward supplies from section 3.1(b)
                        let zeroRatedValue = 0;
                        const zeroRatedMatch = text.match(/\(b\)\s*Outward taxable supplies\s*\(zero rated\)\s*([\d,.]+)/i);
                        if (zeroRatedMatch) {
                            zeroRatedValue = parseFloat(zeroRatedMatch[1].replace(/,/g, '')) || 0;
                        }

                        // Extract exempted outward supplies from section 3.1(c) - nil rated, exempted
                        let exemptedValue = 0;
                        const exemptedMatch = text.match(/\(c\s*\)\s*Other outward supplies\s*\(nil rated,?\s*exempted\)\s*([\d,.]+)/i);
                        if (exemptedMatch) {
                            exemptedValue = parseFloat(exemptedMatch[1].replace(/,/g, '')) || 0;
                        }

                        // Extract e-commerce supplies from section 3.1.1(ii)
                        // "(ii) Taxable supplies made by registered person through electronic commerce operator"
                        // The Total taxable value is the first number after the description
                        let ecommerceSupplies = 0;
                        const ecomMatch = text.match(/\(ii\)\s*Taxable supplies made by registered person through electronic commerce[^\]]*\]\s*([\d,.]+)/i);
                        if (ecomMatch) {
                            ecommerceSupplies = parseFloat(ecomMatch[1].replace(/,/g, '')) || 0;
                        }

                        if (!gstDataByGstin[gstin]) {
                            gstDataByGstin[gstin] = {
                                tradeName: tradeName,
                                legalName: legalName,
                                months: []
                            };
                        }

                        // Update names if found
                        if (tradeName && !gstDataByGstin[gstin].tradeName) {
                            gstDataByGstin[gstin].tradeName = tradeName;
                        }
                        if (legalName && !gstDataByGstin[gstin].legalName) {
                            gstDataByGstin[gstin].legalName = legalName;
                        }

                        // If same amount appears in both Exempted and Ecommerce Supplies,
                        // count only once (in Ecommerce for Hospitality sector)
                        let finalExempted = exemptedValue;
                        let finalEcommerce = ecommerceSupplies;
                        if (exemptedValue > 0 && ecommerceSupplies > 0 && exemptedValue === ecommerceSupplies) {
                            finalExempted = 0; // Count only in Ecommerce column
                        }

                        gstDataByGstin[gstin].months.push({
                            period: period,
                            year: year,
                            taxableValue: taxableValue,
                            zeroRatedValue: zeroRatedValue,
                            exemptedValue: finalExempted,
                            ecommerceSupplies: finalEcommerce,
                            totalOutward: taxableValue + zeroRatedValue + finalExempted + finalEcommerce,
                            integratedTax: integratedTax,
                            centralTax: centralTax,
                            stateTax: stateTax,
                            cess: cess,
                            totalTax: integratedTax + centralTax + stateTax + cess
                        });
                    });

                    // Check if this is Hospitality sector
                    const isHospitality = proposal.industry === 'Hospitality';

                    // Sort months for each GSTIN in chronological order (FY: April to March)
                    const monthOrder = ['April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December', 'January', 'February', 'March'];

                    // Helper function to get sort key for chronological ordering
                    // For FY 2024-25: April-Dec are in 2024, Jan-Mar are in 2025
                    function getSortKey(month) {
                        const fyMatch = month.year.match(/(\d{4})-(\d{2})/);
                        if (!fyMatch) return 0;

                        const fyStartYear = parseInt(fyMatch[1]); // e.g., 2024 from "2024-25"
                        const monthIdx = monthOrder.indexOf(month.period);

                        // April-December (index 0-8) belong to fyStartYear
                        // January-March (index 9-11) belong to fyStartYear + 1
                        let calendarYear = fyStartYear;
                        if (monthIdx >= 9) { // January, February, March
                            calendarYear = fyStartYear + 1;
                        }

                        // Convert month name to number (April=4, May=5, ..., March=3)
                        const calendarMonthMap = {
                            'April': 4, 'May': 5, 'June': 6, 'July': 7,
                            'August': 8, 'September': 9, 'October': 10, 'November': 11,
                            'December': 12, 'January': 1, 'February': 2, 'March': 3
                        };
                        const calendarMonth = calendarMonthMap[month.period] || 1;

                        // Return sortable key: YYYYMM
                        return calendarYear * 100 + calendarMonth;
                    }

                    Object.keys(gstDataByGstin).forEach(gstin => {
                        gstDataByGstin[gstin].months.sort((a, b) => {
                            return getSortKey(a) - getSortKey(b);
                        });
                    });

                    const gstinList = Object.keys(gstDataByGstin);

                    // Check if any data has values (to detect if extraction was truncated)
                    let hasAnyValues = false;
                    gstinList.forEach(gstin => {
                        gstDataByGstin[gstin].months.forEach(m => {
                            if (m.taxableValue > 0 || m.totalTax > 0) hasAnyValues = true;
                        });
                    });
                    %>

                    <%
                    // Calculate GST turnover for FY2025-26 (latest year - to be annualized)
                    // For FY2025-26, only use April 2025 onwards and count UNIQUE months
                    const gstTurnoverByFY = {};
                    const uniqueMonthsByFY = {}; // Track unique months per FY

                    gstinList.forEach(gstin => {
                        const gstData = gstDataByGstin[gstin];
                        gstData.months.forEach(m => {
                            if (!gstTurnoverByFY[m.year]) {
                                gstTurnoverByFY[m.year] = 0;
                                uniqueMonthsByFY[m.year] = new Set();
                            }
                            gstTurnoverByFY[m.year] += m.totalOutward;
                            // Track unique months using period name (April, May, etc.)
                            uniqueMonthsByFY[m.year].add(m.period);
                        });
                    });

                    // Get FYs from GST data and find the latest one
                    const gstFYs = Object.keys(gstTurnoverByFY).sort((a, b) => {
                        const yearA = parseInt(a.split('-')[0]);
                        const yearB = parseInt(b.split('-')[0]);
                        return yearA - yearB;
                    });
                    const latestGstFY = gstFYs[gstFYs.length - 1]; // e.g., "2025-26"

                    // Calculate annualized turnover for latest FY from GST
                    // Use unique month count for proper annualization
                    let projectedTurnover = 0;
                    let projectedMonths = 0;
                    if (latestGstFY && uniqueMonthsByFY[latestGstFY]) {
                        projectedMonths = uniqueMonthsByFY[latestGstFY].size; // Count of unique months
                        projectedTurnover = (gstTurnoverByFY[latestGstFY] / projectedMonths) * 12;
                    }

                    // P&L Sales figures - auto-extract from ITR documents
                    let extractedSales2324 = 0;
                    let extractedSales2425 = 0;
                    let extractedSales2223 = 0;

                    // Extract sales from financial documents
                    const financialDocs = proposal.documents ? proposal.documents.filter(d => d.category === 'financials') : [];
                    financialDocs.forEach(doc => {
                        const classification = (doc.classification || '').toLowerCase();
                        const text = doc.extractedText || '';

                        // Determine FY from classification
                        let docFY = null;
                        if (classification.includes('fy2024-25') || classification.includes('fy 2024-25')) docFY = '2024-25';
                        else if (classification.includes('fy2023-24') || classification.includes('fy 2023-24')) docFY = '2023-24';
                        else if (classification.includes('fy2022-23') || classification.includes('fy 2022-23')) docFY = '2022-23';

                        // Only process business entity ITRs (not individual)
                        if (docFY && (classification.includes('pragati') || classification.includes('pragathi'))) {
                            // Extract SALES amount - pattern: "SALES \n7,69,93,805" or "BY SALES A/C \n12 \n7,63,04,012"
                            const salesMatch = text.match(/(?:BY\s+)?SALES(?:\s+A\/C)?\s*(?:\n?\d+\s*\n)?\s*([\d,]+(?:\.\d+)?)/i);
                            if (salesMatch) {
                                const salesAmount = parseFloat(salesMatch[1].replace(/,/g, ''));
                                if (docFY === '2024-25' && salesAmount > extractedSales2425) extractedSales2425 = salesAmount;
                                else if (docFY === '2023-24' && salesAmount > extractedSales2324) extractedSales2324 = salesAmount;
                                else if (docFY === '2022-23' && salesAmount > extractedSales2223) extractedSales2223 = salesAmount;
                            }
                        }
                    });

                    // Use extracted values if available, otherwise use manually entered data
                    const plSales2324 = extractedSales2324 || proposal.turnoverData?.fy2324 || 0;
                    const plSales2425 = extractedSales2425 || proposal.turnoverData?.fy2425 || 0;

                    // Calculate growth percentages
                    let growth2425 = null;
                    let growth2526 = null;
                    if (plSales2324 > 0 && plSales2425 > 0) {
                        growth2425 = ((plSales2425 - plSales2324) / plSales2324) * 100;
                    }
                    if (plSales2425 > 0 && projectedTurnover > 0) {
                        growth2526 = ((projectedTurnover - plSales2425) / plSales2425) * 100;
                    }
                    %>

                    <!-- Projected Turnover Summary Table -->
                    <div style="margin-bottom: 30px;">
                        <h4 style="color: #2c3e50; margin-bottom: 15px; padding-bottom: 8px; border-bottom: 2px solid #27ae60;">Projected Turnover Summary</h4>
                        <p style="font-size: 0.85em; color: #666; margin-bottom: 15px;">FY2023-24 & FY2024-25: Auto-extracted from ITR Trading Account | FY2025-26: Annualized from GST Returns</p>
                        <div style="overflow-x: auto;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 0.95em; max-width: 900px;">
                                <thead>
                                    <tr style="background: #27ae60; color: white;">
                                        <th style="padding: 12px 15px; text-align: left; border: 1px solid #1e8449; width: 120px;">Years</th>
                                        <th style="padding: 12px 15px; text-align: right; border: 1px solid #1e8449;">
                                            FY2023-24<br><span style="font-size: 0.8em; font-weight: normal;">(P&L Sales)</span>
                                        </th>
                                        <th style="padding: 12px 15px; text-align: right; border: 1px solid #1e8449;">
                                            FY2024-25<br><span style="font-size: 0.8em; font-weight: normal;">(P&L Sales)</span>
                                        </th>
                                        <th style="padding: 12px 15px; text-align: right; border: 1px solid #1e8449;">
                                            FY2025-26<br><span style="font-size: 0.8em; font-weight: normal;">(Projected)</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="background: #fff;">
                                        <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">Turnover</td>
                                        <td style="padding: 12px 15px; text-align: right; border: 1px solid #ddd;">
                                            <% if (plSales2324 > 0) { %>
                                                <span style="font-weight: 600; color: #2980b9;">₹ <%= plSales2324.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
                                            <% } else { %>
                                                <input type="number" id="plSales2324" class="turnover-input" placeholder="Enter P&L Sales"
                                                    value="<%= plSales2324 || '' %>"
                                                    style="width: 140px; padding: 6px 10px; border: 1px solid #ddd; border-radius: 4px; text-align: right;">
                                            <% } %>
                                        </td>
                                        <td style="padding: 12px 15px; text-align: right; border: 1px solid #ddd;">
                                            <% if (plSales2425 > 0) { %>
                                                <span style="font-weight: 600; color: #2980b9;">₹ <%= plSales2425.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
                                            <% } else { %>
                                                <input type="number" id="plSales2425" class="turnover-input" placeholder="Enter P&L Sales"
                                                    value="<%= plSales2425 || '' %>"
                                                    style="width: 140px; padding: 6px 10px; border: 1px solid #ddd; border-radius: 4px; text-align: right;">
                                            <% } %>
                                        </td>
                                        <td style="padding: 12px 15px; text-align: right; border: 1px solid #ddd; font-weight: 600; color: #2980b9;">
                                            <% if (projectedTurnover > 0) { %>
                                                ₹ <%= projectedTurnover.toLocaleString('en-IN', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %>
                                                <br><span style="font-size: 0.75em; color: #888; font-weight: normal;">(Annualised from <%= projectedMonths %> months GST)</span>
                                            <% } else { %>
                                                <span style="color: #888; font-weight: normal;">No GST data</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <tr style="background: #f8f9fa;">
                                        <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">Growth</td>
                                        <td style="padding: 12px 15px; text-align: right; border: 1px solid #ddd; color: #888;">
                                            -
                                        </td>
                                        <td style="padding: 12px 15px; text-align: right; border: 1px solid #ddd; font-weight: 600; color: <%= growth2425 !== null ? (growth2425 >= 0 ? '#27ae60' : '#e74c3c') : '#888' %>;" id="growth2425Cell">
                                            <% if (growth2425 !== null) { %>
                                                <%= growth2425 >= 0 ? '+' : '' %><%= growth2425.toFixed(1) %>%
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                        <td style="padding: 12px 15px; text-align: right; border: 1px solid #ddd; font-weight: 600; color: <%= growth2526 !== null ? (growth2526 >= 0 ? '#27ae60' : '#e74c3c') : '#888' %>;" id="growth2526Cell">
                                            <% if (growth2526 !== null) { %>
                                                <%= growth2526 >= 0 ? '+' : '' %><%= growth2526.toFixed(1) %>%
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <% if (plSales2324 === 0 || plSales2425 === 0) { %>
                        <div style="margin-top: 15px;">
                            <button onclick="saveTurnoverData()" id="saveTurnoverBtn" style="background: #27ae60; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: 500;">
                                Save P&L Sales Data
                            </button>
                        </div>
                        <% } %>
                    </div>

                    <% if (gstinList.length === 0) { %>
                        <div class="placeholder-content">
                            <div class="icon">📈</div>
                            <p>No GST documents uploaded yet. Upload GSTR-3B returns to see monthly turnover details.</p>
                        </div>
                    <% } else { %>
                        <h4 style="color: #2c3e50; margin-bottom: 15px; padding-bottom: 8px; border-bottom: 2px solid #3498db;">Monthly GST Turnover Details</h4>
                        <% if (!hasAnyValues && gstinList.length > 0) { %>
                        <div style="background: #fff3cd; border: 1px solid #ffc107; padding: 15px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong style="color: #856404;">Data extraction may be incomplete</strong>
                                <p style="margin: 5px 0 0 0; color: #856404; font-size: 0.9em;">Click "Re-extract Documents" to fetch complete outward supplies and tax data from GST returns.</p>
                            </div>
                            <button onclick="reExtractTurnover()" style="background: #ffc107; color: #000; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: 600;">
                                Re-extract Documents
                            </button>
                        </div>
                        <% } %>
                        <% gstinList.forEach((gstin, gstIndex) => {
                            const gstData = gstDataByGstin[gstin];
                            let totalTaxableValue = 0;
                            let totalZeroRated = 0;
                            let totalExempted = 0;
                            let totalEcommerce = 0;
                            let totalIntegrated = 0;
                            let totalCentral = 0;
                            let totalState = 0;
                            let totalCess = 0;

                            // Group months by FY for subtotals
                            const monthsByFY = {};
                            gstData.months.forEach(m => {
                                if (!monthsByFY[m.year]) {
                                    monthsByFY[m.year] = [];
                                }
                                monthsByFY[m.year].push(m);
                            });
                            const fyList = Object.keys(monthsByFY).sort();

                            // Calculate column count based on sector (added Zero Rated column)
                            const colCount = isHospitality ? 12 : 11;
                        %>
                        <div class="gstin-section" style="margin-bottom: 30px; <% if(gstIndex > 0) { %>border-top: 2px solid #3498db; padding-top: 20px;<% } %>">
                            <div style="background: #e8f4fc; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                                <h4 style="margin: 0 0 10px 0; color: #2c3e50;">GSTIN: <%= gstin %></h4>
                                <% if (gstData.tradeName || gstData.legalName) { %>
                                    <p style="margin: 0; color: #555;">
                                        <% if (gstData.tradeName) { %><strong>Trade Name:</strong> <%= gstData.tradeName %><% } %>
                                        <% if (gstData.tradeName && gstData.legalName) { %> | <% } %>
                                        <% if (gstData.legalName) { %><strong>Legal Name:</strong> <%= gstData.legalName %><% } %>
                                    </p>
                                <% } %>
                            </div>

                            <div style="overflow-x: auto;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 0.9em;">
                                    <thead>
                                        <tr style="background: #3498db; color: white;">
                                            <th style="padding: 12px 8px; text-align: left; border: 1px solid #2980b9;">Month</th>
                                            <th style="padding: 12px 8px; text-align: left; border: 1px solid #2980b9;">FY</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">Taxable Supplies</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">Zero Rated</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">Exempted</th>
                                            <% if (isHospitality) { %>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">Ecommerce Supplies</th>
                                            <% } %>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">Total Outward</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">IGST</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">CGST</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">SGST</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">Cess</th>
                                            <th style="padding: 12px 8px; text-align: right; border: 1px solid #2980b9;">Total Tax</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% let rowIdx = 0;
                                           fyList.forEach((fy, fyIdx) => {
                                            const fyMonths = monthsByFY[fy];
                                            let fyTaxable = 0, fyZeroRated = 0, fyExempted = 0, fyEcommerce = 0, fyIntegrated = 0, fyCentral = 0, fyState = 0, fyCess = 0;

                                            fyMonths.forEach((m) => {
                                                fyTaxable += m.taxableValue;
                                                fyZeroRated += m.zeroRatedValue || 0;
                                                fyExempted += m.exemptedValue || 0;
                                                fyEcommerce += m.ecommerceSupplies || 0;
                                                fyIntegrated += m.integratedTax;
                                                fyCentral += m.centralTax;
                                                fyState += m.stateTax;
                                                fyCess += m.cess;

                                                totalTaxableValue += m.taxableValue;
                                                totalZeroRated += m.zeroRatedValue || 0;
                                                totalExempted += m.exemptedValue || 0;
                                                totalEcommerce += m.ecommerceSupplies || 0;
                                                totalIntegrated += m.integratedTax;
                                                totalCentral += m.centralTax;
                                                totalState += m.stateTax;
                                                totalCess += m.cess;
                                        %>
                                        <tr style="background: <%= rowIdx % 2 === 0 ? '#fff' : '#f8f9fa' %>;">
                                            <td style="padding: 10px 8px; border: 1px solid #ddd;"><%= m.period %></td>
                                            <td style="padding: 10px 8px; border: 1px solid #ddd;"><%= m.year %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= m.taxableValue.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= (m.zeroRatedValue || 0).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= (m.exemptedValue || 0).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <% if (isHospitality) { %>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= (m.ecommerceSupplies || 0).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <% } %>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd; font-weight: 600; color: #2980b9;">₹ <%= m.totalOutward.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= m.integratedTax.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= m.centralTax.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= m.stateTax.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd;">₹ <%= m.cess.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #ddd; font-weight: 600; color: #27ae60;">₹ <%= m.totalTax.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                        </tr>
                                        <% rowIdx++; }); %>
                                        <!-- FY Subtotal Row -->
                                        <tr style="background: #34495e; color: white; font-weight: 600;">
                                            <td colspan="2" style="padding: 10px 8px; border: 1px solid #2c3e50;">FY <%= fy %> Total</td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyTaxable.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyZeroRated.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyExempted.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <% if (isHospitality) { %>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyEcommerce.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <% } %>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= (fyTaxable + fyZeroRated + fyExempted + fyEcommerce).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyIntegrated.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyCentral.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyState.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= fyCess.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 10px 8px; text-align: right; border: 1px solid #2c3e50;">₹ <%= (fyIntegrated + fyCentral + fyState + fyCess).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                        </tr>
                                        <% }); %>
                                    </tbody>
                                    <tfoot>
                                        <tr style="background: #2c3e50; color: white; font-weight: bold;">
                                            <td colspan="2" style="padding: 12px 8px; border: 1px solid #1a252f;">GRAND TOTAL</td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalTaxableValue.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalZeroRated.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalExempted.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <% if (isHospitality) { %>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalEcommerce.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <% } %>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= (totalTaxableValue + totalZeroRated + totalExempted + totalEcommerce).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalIntegrated.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalCentral.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalState.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= totalCess.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                            <td style="padding: 12px 8px; text-align: right; border: 1px solid #1a252f;">₹ <%= (totalIntegrated + totalCentral + totalState + totalCess).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <% }); %>
                    <% } %>
                </div>

                <div id="debtProfilePanel" class="analysis-panel">
                    <h3>Debt Profile Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">💳</div>
                        <p>Debt profile documents and analysis will be displayed here.</p>
                    </div>
                </div>

                <div id="collateralPanel" class="analysis-panel">
                    <h3>Collateral Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">🏠</div>
                        <p>Collateral documents - Technical & Legal analysis will be displayed here.</p>
                    </div>
                </div>

                <div id="networthPanel" class="analysis-panel">
                    <h3>Net Worth Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">📊</div>
                        <p>Asset base and net worth of customer will be displayed here.</p>
                    </div>
                </div>

                <div id="eligibilityPanel" class="analysis-panel">
                    <h3>Eligibility Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">✅</div>
                        <p>Eligibility basis and calculations will be displayed here.</p>
                    </div>
                </div>

                <div id="googleChecksPanel" class="analysis-panel">
                    <h3>Google Checks Analysis</h3>
                    <div class="placeholder-content">
                        <div class="icon">🔍</div>
                        <p>Google check and other background verification results will be displayed here.</p>
                    </div>
                </div>

                <div id="deviationsPanel" class="analysis-panel">
                    <h3>Deviations</h3>
                    <div class="placeholder-content">
                        <div class="icon">⚠️</div>
                        <p>Policy deviations identified in the case will be displayed here.</p>
                    </div>
                </div>

                <div id="concernsPanel" class="analysis-panel">
                    <h3>Concerns in the Case</h3>
                    <div class="placeholder-content">
                        <div class="icon">🚨</div>
                        <p>Key concerns and risk factors will be displayed here.</p>
                    </div>
                </div>

                <div id="strengthsPanel" class="analysis-panel">
                    <h3>Strengths of the Case</h3>
                    <div class="placeholder-content">
                        <div class="icon">💪</div>
                        <p>Key strengths and positive factors will be displayed here.</p>
                    </div>
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="form-actions">
                <a href="/stage2/<%= proposal.id %>" class="btn btn-secondary">Back to Documents</a>
            </div>
        </div>
    </div>

    <script>
        const proposalId = '<%= proposal.id %>';

        // Main Tab Switching (CAM / Analysis)
        function showMainTab(tab) {
            // Update tab buttons
            document.querySelectorAll('.main-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');

            // Update tab content
            document.querySelectorAll('.main-tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById(tab + 'Tab').classList.add('active');
        }

        // Analysis Sub-tab Switching
        function showAnalysisTab(tab) {
            // Update sub-tab buttons
            document.querySelectorAll('.analysis-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');

            // Update panel content
            document.querySelectorAll('.analysis-panel').forEach(p => p.classList.remove('active'));
            document.getElementById(tab + 'Panel').classList.add('active');
        }

        // Navigate from CAM table to Analysis tab
        function goToAnalysis(tab) {
            // Switch to Analysis main tab
            document.querySelectorAll('.main-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.main-tab')[1].classList.add('active'); // Analysis is second tab

            document.querySelectorAll('.main-tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById('analysisTab').classList.add('active');

            // Switch to specific sub-tab
            document.querySelectorAll('.analysis-tab').forEach(t => t.classList.remove('active'));
            // Find and activate the matching tab button
            const tabButtons = document.querySelectorAll('.analysis-tab');
            tabButtons.forEach(btn => {
                if (btn.textContent.toLowerCase().replace(/\s+/g, '') === tab.toLowerCase() ||
                    btn.onclick.toString().includes("'" + tab + "'")) {
                    btn.classList.add('active');
                }
            });

            // Show the panel
            document.querySelectorAll('.analysis-panel').forEach(p => p.classList.remove('active'));
            const panel = document.getElementById(tab + 'Panel');
            if (panel) {
                panel.classList.add('active');
            }

            // Scroll to top of analysis section
            document.getElementById('analysisTab').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Re-extract turnover documents (for incomplete data warning)
        async function reExtractTurnover() {
            const btn = event.target;
            btn.disabled = true;
            btn.textContent = 'Extracting...';

            try {
                const response = await fetch(`/stage2/${proposalId}/extract-turnover`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.success) {
                    alert(`Successfully re-extracted ${data.count} documents. Refreshing page...`);
                    window.location.reload();
                } else {
                    alert('Error: ' + data.message);
                    btn.disabled = false;
                    btn.textContent = 'Re-extract Documents';
                }
            } catch (err) {
                alert('Error re-extracting documents: ' + err.message);
                btn.disabled = false;
                btn.textContent = 'Re-extract Documents';
            }
        }

        // Refresh turnover data (for newly uploaded GST returns)
        async function refreshTurnoverData() {
            const btn = document.getElementById('refreshTurnoverBtn');
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span style="font-size: 1.1em;">&#8635;</span> Refreshing...';

            try {
                const response = await fetch(`/stage2/${proposalId}/extract-turnover`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.success) {
                    btn.innerHTML = '<span style="font-size: 1.1em;">&#10003;</span> Done!';
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                } else {
                    alert('Error: ' + data.message);
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                }
            } catch (err) {
                alert('Error refreshing data: ' + err.message);
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }
        }

        // Store server-side values for client-side use
        const serverData = {
            plSales2324: <%= proposal.turnoverData?.fy2324 || 0 %>,
            plSales2425: <%= proposal.turnoverData?.fy2425 || 0 %>,
            projectedTurnover: <%= typeof projectedTurnover !== 'undefined' ? projectedTurnover : 0 %>
        };

        // Save P&L Sales turnover data
        async function saveTurnoverData() {
            const btn = document.getElementById('saveTurnoverBtn');
            const fy2324Input = document.getElementById('plSales2324');
            const fy2425Input = document.getElementById('plSales2425');

            const fy2324 = fy2324Input ? parseFloat(fy2324Input.value) || 0 : serverData.plSales2324;
            const fy2425 = fy2425Input ? parseFloat(fy2425Input.value) || 0 : serverData.plSales2425;

            if (fy2324 === 0 && fy2425 === 0) {
                alert('Please enter at least one P&L sales value');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Saving...';

            try {
                const response = await fetch(`/stage3/${proposalId}/save-turnover-data`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fy2324, fy2425 })
                });
                const data = await response.json();

                if (data.success) {
                    btn.textContent = 'Saved!';
                    btn.style.background = '#27ae60';
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                } else {
                    alert('Error: ' + data.message);
                    btn.disabled = false;
                    btn.textContent = 'Save P&L Sales Data';
                }
            } catch (err) {
                alert('Error saving data: ' + err.message);
                btn.disabled = false;
                btn.textContent = 'Save P&L Sales Data';
            }
        }

        // Update growth percentages dynamically when P&L values change
        document.addEventListener('DOMContentLoaded', function() {
            const fy2324Input = document.getElementById('plSales2324');
            const fy2425Input = document.getElementById('plSales2425');
            const projectedTurnover = serverData.projectedTurnover;

            function updateGrowthDisplay() {
                const fy2324 = fy2324Input ? parseFloat(fy2324Input.value) || 0 : 0;
                const fy2425 = fy2425Input ? parseFloat(fy2425Input.value) || 0 : 0;

                // Update FY2024-25 growth
                const growth2425Cell = document.getElementById('growth2425Cell');
                if (growth2425Cell && fy2324 > 0 && fy2425 > 0) {
                    const growth = ((fy2425 - fy2324) / fy2324) * 100;
                    growth2425Cell.textContent = (growth >= 0 ? '+' : '') + growth.toFixed(1) + '%';
                    growth2425Cell.style.color = growth >= 0 ? '#27ae60' : '#e74c3c';
                }

                // Update FY2025-26 growth
                const growth2526Cell = document.getElementById('growth2526Cell');
                if (growth2526Cell && fy2425 > 0 && projectedTurnover > 0) {
                    const growth = ((projectedTurnover - fy2425) / fy2425) * 100;
                    growth2526Cell.textContent = (growth >= 0 ? '+' : '') + growth.toFixed(1) + '%';
                    growth2526Cell.style.color = growth >= 0 ? '#27ae60' : '#e74c3c';
                }
            }

            if (fy2324Input) fy2324Input.addEventListener('input', updateGrowthDisplay);
            if (fy2425Input) fy2425Input.addEventListener('input', updateGrowthDisplay);
        });
    </script>
</body>
</html>
